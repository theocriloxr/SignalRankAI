# Railway Hobby: real-execution readiness profile.
# This template DOES NOT enable real orders. Activation requires a separate,
# reviewed owner decision after demo reconciliation and live advisory evidence.
APP_ENV=production
RUN_MODE=all
PUBLIC_TESTING_MODE=0
AUTO_MIGRATE=0

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{RedisState.REDIS_URL}}
STATE_REDIS_URL=${{RedisState.REDIS_URL}}
DELIVERY_REDIS_URL=${{RedisDelivery.REDIS_URL}}
REQUIRE_DISTINCT_DELIVERY_REDIS=1
REDIS_MAX_CONNECTIONS=24

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_DOMAIN=
OWNER_TELEGRAM_ID=
OWNER_IDS=
ADMIN_IDS=
ENCRYPTION_KEY=
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

UVICORN_WORKERS=1
WEBHOOK_UPDATE_WORKERS=4
WEBHOOK_UPDATE_QUEUE_SIZE=1000
WEBHOOK_REDIS_QUEUE_ENABLED=1

DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
DB_POOL_TIMEOUT_SECONDS=15
DB_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=1
DB_POOL_DISABLE_RAILWAY_CAP=0
DB_POOL_ALLOW_UNCAPPED_RAILWAY=0

ENGINE_UNIVERSE_CAP=18
CYCLE_BATCH_SIZE=6
MARKET_FETCH_ASSET_CONCURRENCY=2
MARKET_CACHE_FETCH_CONCURRENCY=2
ALL_ASSET_MODE=1
ASSET_CLASSES_ENABLED=crypto,fx,index,commodity,stock
WS_INGEST_ENABLED=0

RESOURCE_GUARD_ENABLED=1
APP_MEMORY_LIMIT_MB=0
APP_MEMORY_SOFT_RATIO=0.72
APP_MEMORY_HARD_RATIO=0.88
APP_MEMORY_CRITICAL_RATIO=0.96
APP_MEMORY_RECOVERY_MARGIN_MB=32
RESOURCE_RECOVERY_SAMPLES=3
RESOURCE_RECOVERY_HYSTERESIS_RATIO=0.10
RESOURCE_CPU_SOFT_PERCENT=75
RESOURCE_CPU_HARD_PERCENT=90
RESOURCE_CPU_CRITICAL_PERCENT=98
RESOURCE_EVENT_LOOP_SOFT_MS=100
RESOURCE_EVENT_LOOP_HARD_MS=500
RESOURCE_EVENT_LOOP_CRITICAL_MS=2000
RESOURCE_DB_QUEUE_SOFT=2
RESOURCE_DB_QUEUE_HARD=6
RESOURCE_DB_QUEUE_CRITICAL=12
RESOURCE_DB_WAIT_SOFT_MS=250
RESOURCE_DB_WAIT_HARD_MS=1000
RESOURCE_DB_WAIT_CRITICAL_MS=5000
RESOURCE_REDIS_SOFT_MS=50
RESOURCE_REDIS_HARD_MS=200
RESOURCE_REDIS_CRITICAL_MS=1000
RESOURCE_DELIVERY_QUEUE_SOFT_RATIO=0.60
RESOURCE_DELIVERY_QUEUE_HARD_RATIO=0.80
RESOURCE_DELIVERY_QUEUE_CRITICAL_RATIO=0.95
RESOURCE_PROVIDER_ERROR_SOFT_RATIO=0.10
RESOURCE_PROVIDER_ERROR_HARD_RATIO=0.30
RESOURCE_PROVIDER_ERROR_CRITICAL_RATIO=0.60
RESOURCE_RETRY_AFTER_SOFT_RATIO=0.02
RESOURCE_RETRY_AFTER_HARD_RATIO=0.10
RESOURCE_RETRY_AFTER_CRITICAL_RATIO=0.25
RESOURCE_PENDING_TASKS_SOFT=100
RESOURCE_PENDING_TASKS_HARD=300
RESOURCE_PENDING_TASKS_CRITICAL=1000

FINAL_SEND_LIVE_PRICE_CHECK_ENABLED=1
FINAL_SEND_FORCE_FRESH_PRICE=1
DELIVERY_REQUIRE_LIVE_PRICE=1
DELIVERY_FRESHNESS_TIMEOUT_FAIL_OPEN=0
DELIVERY_FRESHNESS_ERROR_FAIL_OPEN=0
DELIVERY_MISSING_PRICE_FAIL_OPEN=0
OUTCOME_TRACK_DELIVERED_ONLY=1
PORTFOLIO_EXPOSURE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_MIN_TRADES=30
ASSET_REPEAT_LOCK_REQUIRE_DELIVERED=1

ENABLE_NEWS=1
ENABLE_ML=1
ML_OFFLINE_BOOTSTRAP_ENABLED=0
ML_TRAIN_ENABLED=0
ANALYTICS_ML_TRAIN_ENABLED=0
ML_DRIFT_MONITOR_ENABLED=0
ML_ARCHIVE_BACKFILL_ENABLED=0

# Fail-closed execution gate. These remain zero in the checked-in template.
PAPER_MODE=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_EXECUTION_ENABLED=0
MT5_ALLOW_LIVE_ACCOUNTS=0
REAL_EXECUTION_APPROVAL_REQUIRED=1
REAL_EXECUTION_REQUIRE_CONSENT=1
REAL_EXECUTION_REQUIRE_LIVE_QUOTE=1
REAL_EXECUTION_REQUIRE_SYMBOL_SPEC=1
REAL_EXECUTION_REQUIRE_IDEMPOTENCY=1
REAL_EXECUTION_REQUIRE_RECONCILIATION=1
REAL_EXECUTION_RESOURCE_CRITICAL_BLOCK=1
REAL_PAYOUTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
AUTOMATON_MODE=SIMULATION
CODEXOPS_MODE=READ_ONLY_AUDIT

LOG_JSON=1
OBSERVABILITY_METRICS_ENABLED=1
RUN_DB_MIGRATIONS_AT_BOOT=false
INSTALL_AT_BOOT=false
ALLOW_DOTENV=false

# Additional optional market-data providers. Keep blank unless the adapter is enabled.
EODHD_API_KEY=
EODHD_API_TOKEN=
MARKETSTACK_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
NASDAQ_DATA_LINK_API_KEY=
NASDAQ_DATA_LINK_DATASETS_JSON=

# Proof-backed same-asset delivery policy
ASSET_REPEAT_LOCK_HOURS=4
DELIVERY_SAME_ASSET_COOLDOWN_HOURS=4
COOLDOWN_PREFLIGHT_FAIL_OPEN=0
# Deployment diagnostics and safe network defaults
CRYPTO_WS_ENABLED=0
PROXY_VALIDATION_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENABLED=1
DEPLOYMENT_DIAGNOSTICS_LIVE_PROVIDERS=0
DEPLOYMENT_FULL_TESTS_ENABLED=0
DEPLOYMENT_EXTENDED_SCANS_ENABLED=0
DEPLOYMENT_MUTATION_TESTS_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENDPOINT_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_REPORT_PATH=/tmp/signalrank_deployment_diagnostics.json
# Set and seal before enabling the endpoint:
DEPLOYMENT_DIAGNOSTICS_KEY=
DEPLOYMENT_TEST_CHAT_ID=
DEPLOYMENT_TELEGRAM_SEND_TEST=0
