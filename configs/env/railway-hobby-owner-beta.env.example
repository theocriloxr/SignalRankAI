# Railway Hobby: owner-only advisory soak. Start crypto-only and REST-first.
APP_ENV=production
RUN_MODE=all
PUBLIC_TESTING_MODE=0
AUTO_MIGRATE=0
RUN_ENGINE_LOOP=0
RUN_WORKER_LOOP=1

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_MIGRATION_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{RedisState.REDIS_URL}}
STATE_REDIS_URL=${{RedisState.REDIS_URL}}
DELIVERY_REDIS_URL=${{RedisDelivery.REDIS_URL}}
REQUIRE_DISTINCT_DELIVERY_REDIS=1
REDIS_MAX_CONNECTIONS=24

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=<GENERATE_RANDOM_SECRET>
WEBHOOK_DOMAIN=
OWNER_TELEGRAM_ID=
OWNER_IDS=
ADMIN_IDS=
ENCRYPTION_KEY=
API_TOKEN_PEPPER=
STARTUP_SCHEMA_BOOTSTRAP=0
DRY_RUN=0

UVICORN_WORKERS=1
WEBHOOK_UPDATE_WORKERS=4
WEBHOOK_UPDATE_QUEUE_SIZE=1000
WEBHOOK_REDIS_QUEUE_ENABLED=1
TELEGRAM_ALLOWED_UPDATES=message,edited_message,callback_query,my_chat_member,chat_member,pre_checkout_query,shipping_query
TELEGRAM_DROP_PENDING_UPDATES_ON_STARTUP=0
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=20

DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
DB_POOL_TIMEOUT_SECONDS=15
DB_READINESS_TIMEOUT_SECONDS=8
DB_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=1
DB_POOL_DISABLE_RAILWAY_CAP=0
DB_POOL_ALLOW_UNCAPPED_RAILWAY=0

ENGINE_UNIVERSE_CAP=12
CYCLE_BATCH_SIZE=4
MARKET_FETCH_ASSET_CONCURRENCY=2
MARKET_CACHE_FETCH_CONCURRENCY=2
ALL_ASSET_MODE=0
CRYPTO_ONLY_MODE=1
ASSET_CLASSES_ENABLED=crypto
CRYPTO_MARKET_DATA_PROVIDERS=coinbase,okx
CRYPTO_PREFERRED_PROVIDER=coinbase
WS_INGEST_ENABLED=0

# Auto-detected cgroup memory with conservative hysteresis.
RESOURCE_GUARD_ENABLED=1
APP_MEMORY_LIMIT_MB=0
APP_MEMORY_SOFT_RATIO=0.72
APP_MEMORY_HARD_RATIO=0.88
APP_MEMORY_CRITICAL_RATIO=0.96
APP_MEMORY_RECOVERY_MARGIN_MB=32
RESOURCE_RECOVERY_SAMPLES=3
RESOURCE_RECOVERY_HYSTERESIS_RATIO=0.10
RESOURCE_CPU_SOFT_PERCENT=75
RESOURCE_CPU_HARD_PERCENT=90
RESOURCE_CPU_CRITICAL_PERCENT=98
RESOURCE_EVENT_LOOP_SOFT_MS=100
RESOURCE_EVENT_LOOP_HARD_MS=500
RESOURCE_EVENT_LOOP_CRITICAL_MS=2000
RESOURCE_DB_QUEUE_SOFT=2
RESOURCE_DB_QUEUE_HARD=6
RESOURCE_DB_QUEUE_CRITICAL=12
RESOURCE_DB_WAIT_SOFT_MS=250
RESOURCE_DB_WAIT_HARD_MS=1000
RESOURCE_DB_WAIT_CRITICAL_MS=5000
RESOURCE_REDIS_SOFT_MS=50
RESOURCE_REDIS_HARD_MS=200
RESOURCE_REDIS_CRITICAL_MS=1000
RESOURCE_DELIVERY_QUEUE_SOFT_RATIO=0.60
RESOURCE_DELIVERY_QUEUE_HARD_RATIO=0.80
RESOURCE_DELIVERY_QUEUE_CRITICAL_RATIO=0.95
RESOURCE_PROVIDER_ERROR_SOFT_RATIO=0.10
RESOURCE_PROVIDER_ERROR_HARD_RATIO=0.30
RESOURCE_PROVIDER_ERROR_CRITICAL_RATIO=0.60
RESOURCE_RETRY_AFTER_SOFT_RATIO=0.02
RESOURCE_RETRY_AFTER_HARD_RATIO=0.10
RESOURCE_RETRY_AFTER_CRITICAL_RATIO=0.25
RESOURCE_PENDING_TASKS_SOFT=100
RESOURCE_PENDING_TASKS_HARD=300
RESOURCE_PENDING_TASKS_CRITICAL=1000

FINAL_SEND_LIVE_PRICE_CHECK_ENABLED=1
FINAL_SEND_FORCE_FRESH_PRICE=1
DELIVERY_REQUIRE_LIVE_PRICE=1
DELIVERY_FRESHNESS_TIMEOUT_FAIL_OPEN=0
DELIVERY_FRESHNESS_ERROR_FAIL_OPEN=0
DELIVERY_MISSING_PRICE_FAIL_OPEN=0
OUTCOME_TRACK_DELIVERED_ONLY=1
WORKER_OUTCOME_TRACKER_ENABLED=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
PORTFOLIO_EXPOSURE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_MIN_TRADES=30
ASSET_REPEAT_LOCK_REQUIRE_DELIVERED=1

# Owner soak keeps optional/heavy intelligence off.
ENABLE_NEWS=0
ENABLE_ML=0
ML_OFFLINE_BOOTSTRAP_ENABLED=0
ML_TRAIN_ENABLED=0
ANALYTICS_ML_TRAIN_ENABLED=0
ML_DRIFT_MONITOR_ENABLED=0
ML_ARCHIVE_BACKFILL_ENABLED=0
ASSET_LEARNING_ENABLED=0
SHADOW_OUTCOME_TRACKER_ENABLED=0

PAPER_MODE=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_EXECUTION_ENABLED=0
MT5_ALLOW_LIVE_ACCOUNTS=0
REAL_PAYOUTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
FREE_RANDOM_DISTRIBUTION_ENABLED=0
AUTOMATON_MODE=SIMULATION
CODEXOPS_MODE=READ_ONLY_AUDIT

LOG_JSON=1
OBSERVABILITY_METRICS_ENABLED=1
RUN_DB_MIGRATIONS_AT_BOOT=false
INSTALL_AT_BOOT=false
ALLOW_DOTENV=false

# Additional optional market-data providers. Keep blank unless the adapter is enabled.
EODHD_API_KEY=
EODHD_API_TOKEN=
MARKETSTACK_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
NASDAQ_DATA_LINK_API_KEY=
NASDAQ_DATA_LINK_DATASETS_JSON=

# Proof-backed same-asset delivery policy
ASSET_REPEAT_LOCK_HOURS=4
DELIVERY_SAME_ASSET_COOLDOWN_HOURS=4
COOLDOWN_PREFLIGHT_FAIL_OPEN=0
# Deployment diagnostics and safe network defaults
CRYPTO_WS_ENABLED=0
PROXY_VALIDATION_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENABLED=1
DEPLOYMENT_DIAGNOSTICS_LIVE_PROVIDERS=0
DEPLOYMENT_FULL_TESTS_ENABLED=0
DEPLOYMENT_EXTENDED_SCANS_ENABLED=0
DEPLOYMENT_MUTATION_TESTS_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENDPOINT_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_REPORT_PATH=/tmp/signalrank_deployment_diagnostics.json
# Set and seal before enabling the endpoint:
DEPLOYMENT_DIAGNOSTICS_KEY=
DEPLOYMENT_TEST_CHAT_ID=
DEPLOYMENT_TELEGRAM_SEND_TEST=0

# v1.0.6 delivery fanout and DB-admission controls
# Optional comma-separated Telegram IDs. Keep blank in production; use a single
# owner ID during staging proof to isolate delivery behaviour.
DELIVERY_AUDIENCE_ALLOWLIST=
ENGINE_DELIVERY_FANOUT_LOCK_SECONDS=600
RESEND_SKIP_WHEN_ENGINE_FANOUT_ACTIVE=1
DELIVERY_DEDUP_TIMEOUT_SECONDS=12
DELIVERY_DAILY_LIMIT_TIMEOUT_SECONDS=12
DELIVERY_PROFILE_TIMEOUT_SECONDS=12
DELIVERY_RESERVE_TIMEOUT_SECONDS=15
DELIVERY_PHASE_TIMEOUT_SECONDS=15
DELIVERY_PROOF_TIMEOUT_SECONDS=15
OUTCOME_DB_ADMISSION_TIMEOUT_SECONDS=1
# v1.0.7 startup keyboard maintenance safety
# Keep disabled on Railway unless a one-shot historical keyboard repair is required.
ACTIVE_SIGNAL_KEYBOARD_REFRESH_ENABLED=0
ACTIVE_SIGNAL_KEYBOARD_REFRESH_STARTUP_DELAY_SECONDS=120
ACTIVE_SIGNAL_KEYBOARD_REFRESH_LIMIT=200
ACTIVE_SIGNAL_KEYBOARD_REFRESH_CONCURRENCY=4
ACTIVE_SIGNAL_KEYBOARD_REFRESH_DB_TIMEOUT_SECONDS=2
ACTIVE_SIGNAL_KEYBOARD_REFRESH_TELEGRAM_TIMEOUT_SECONDS=10
# Idempotent Telegram webhook registration for rapid Railway deploys
TELEGRAM_FORCE_WEBHOOK_REREGISTER=0
TELEGRAM_WEBHOOK_SET_MAX_ATTEMPTS=2

# v1.0.8 operational contention and Telegram UX controls
TELEGRAM_RICH_MESSAGES_CERTIFIED=0
MONITOR_REFRESH_ENABLED=1
MONITOR_REFRESH_LIMIT=100
MONITOR_REFRESH_CONCURRENCY=4
MONITOR_REFRESH_DB_TIMEOUT_SECONDS=2
MONITOR_REFRESH_SNAPSHOT_TIMEOUT_SECONDS=8
MONITOR_REFRESH_TELEGRAM_TIMEOUT_SECONDS=10
MONITOR_REFRESH_JOB_TIMEOUT_SECONDS=45
RESEND_AUDIENCE_ALLOWLIST_ONLY=0
RESEND_MAX_USERS_PER_RUN=25
RESEND_JOB_TIMEOUT_SECONDS=90
ENGINE_PULSE_DISTRIBUTED_LOCK_ENABLED=1
ENGINE_PULSE_LOCK_TTL_SECONDS=3570
ENGINE_PULSE_LOCK_KEY=signalrank:admin_pulse:hourly
PROVIDER_RECOVERY_REQUIRED_SUCCESSES=3
PROVIDER_RECOVERY_STABLE_SECONDS=120
# v1.1.0 adaptive asset-specific strategy intelligence
ADAPTIVE_STRATEGY_ENGINE_ENABLED=1
ADAPTIVE_STRATEGY_GENERATION_ENABLED=1
ADAPTIVE_SHADOW_CANDIDATES_IN_SIGNAL_PIPELINE_ENABLED=0
ADAPTIVE_OPTIMISATION_ENABLED=1
ADAPTIVE_CANDIDATE_MIN_CONFIDENCE=0.72
ADAPTIVE_MAX_CANDIDATES_PER_ASSET=3
ADAPTIVE_EVALUATION_TIMEFRAMES=5m,15m,1h,4h,1d
ADAPTIVE_MIN_CANDLES_PER_TIMEFRAME=30
ADAPTIVE_PRE_SIGNAL_CANDLES=120
ADAPTIVE_MIN_OUTCOME_SAMPLES=40
ADAPTIVE_LOOKBACK_DAYS=365
ADAPTIVE_SEGMENT_MAX_DRAWDOWN_R=12
ADAPTIVE_DB_TIMEOUT_SECONDS=8
ADAPTIVE_LEARNING_WORKER_ENABLED=1
ADAPTIVE_LEARNING_INTERVAL_SECONDS=21600
ADAPTIVE_LEARNING_STARTUP_DELAY_SECONDS=300
ADAPTIVE_AUTO_PROMOTION_ENABLED=0
ADAPTIVE_REQUIRE_HUMAN_APPROVAL=1
ADAPTIVE_CANDLE_CAPTURE_ENABLED=1
ADAPTIVE_CANDLE_CAPTURE_MAX_PER_TIMEFRAME=200
ADAPTIVE_CANDLE_QUEUE_MAX=2000
ADAPTIVE_CANDLE_CAPTURE_INTERVAL_SECONDS=10
ADAPTIVE_CANDLE_CAPTURE_BATCH_SIZE=12
ADAPTIVE_CANDLE_DB_TIMEOUT_SECONDS=4

# Chronological walk-forward validation and cost modelling
ADAPTIVE_WFO_MINIMUM_TRAIN_ROWS=80
ADAPTIVE_WFO_VALIDATION_ROWS=30
ADAPTIVE_WFO_EMBARGO_SECONDS=0
ADAPTIVE_WFO_COST_R=0.01

# Live-profile drift suspension and rollback
ADAPTIVE_DRIFT_MIN_LIVE_SAMPLES=30
ADAPTIVE_DRIFT_MAX_DRAWDOWN_R=10
ADAPTIVE_DRIFT_MAX_BRIER=0.35
ADAPTIVE_DRIFT_MIN_EXPECTANCY_R=-0.10
