# Production contract. This is intentionally conservative and cannot activate
# public payments, real payouts, copy trading or auto trading by default.
APP_ENV=production
RUN_MODE=all
PUBLIC_TESTING_MODE=0
AUTO_MIGRATE=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_PAYOUTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
AUTOMATON_MODE=SIMULATION
CODEXOPS_MODE=READ_ONLY_AUDIT

DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
DB_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=1
DB_POOL_DISABLE_RAILWAY_CAP=0
DB_POOL_ALLOW_UNCAPPED_RAILWAY=0

MARKET_FETCH_ASSET_CONCURRENCY=2
MARKET_CACHE_FETCH_CONCURRENCY=2
COINBASE_OHLC_MAX_CONCURRENCY=2
OKX_OHLC_MAX_CONCURRENCY=2
BYBIT_OHLC_MAX_CONCURRENCY=1
YFINANCE_OHLC_MAX_CONCURRENCY=1
OHLC_PROVIDER_REQUEST_TIMEOUT_SECONDS=7
OHLC_REQUIRED_ASSET_TIMEOUT_SECONDS=20
OHLC_OPTIONAL_ASSET_TIMEOUT_SECONDS=12
OHLC_ENGINE_BATCH_TIMEOUT_SECONDS=50
OHLC_MAX_PROVIDER_ATTEMPTS_PER_TIMEFRAME=2
OHLC_ORPHAN_TASK_GUARD_ENABLED=1
DEFAULT_TRADING_STYLE=day

FINAL_SEND_LIVE_PRICE_CHECK_ENABLED=1
FINAL_SEND_FORCE_FRESH_PRICE=1
DELIVERY_REQUIRE_LIVE_PRICE=1
DELIVERY_FRESHNESS_TIMEOUT_FAIL_OPEN=0
DELIVERY_FRESHNESS_ERROR_FAIL_OPEN=0
DELIVERY_MISSING_PRICE_FAIL_OPEN=0
OUTCOME_TRACK_DELIVERED_ONLY=1
WORKER_OUTCOME_TRACKER_ENABLED=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
REALTIME_OUTCOME_TRACKER_ENABLED=1
SEND_OUTCOME_NOTIFICATIONS_ENABLED=1
WS_INGEST_ENABLED=0

OBSERVABILITY_METRICS_ENABLED=1
LOG_JSON=1
# Provider request coordination
OHLC_PROVIDER_QUEUE_TIMEOUT_SECONDS=10
OHLC_INFLIGHT_WAIT_TIMEOUT_SECONDS=25
OHLC_DEFAULT_PROVIDER_MAX_CONCURRENCY=1
BINANCE_OHLC_MAX_CONCURRENCY=1
TWELVEDATA_OHLC_MAX_CONCURRENCY=1
POLYGON_OHLC_MAX_CONCURRENCY=1
FMP_OHLC_MAX_CONCURRENCY=1
OANDA_OHLC_MAX_CONCURRENCY=1
TRADINGVIEW_OHLC_MAX_CONCURRENCY=1
TIINGO_OHLC_MAX_CONCURRENCY=1
ALPHAVANTAGE_OHLC_MAX_CONCURRENCY=1

# Webhook and delivery queue safety
WEBHOOK_REDIS_QUEUE_ENABLED=1
WEBHOOK_UPDATE_WORKERS=8
WEBHOOK_UPDATE_QUEUE_SIZE=2000
REDIS_WEBHOOK_QUEUE_MAX_DEPTH=5000
BROADCASTER_MAX_PARALLEL=25
BROADCASTER_MAX_RETRIES=3
DELIVERY_RECONCILE_BATCH_SIZE=100
DELIVERY_RECONCILE_INTERVAL_SECONDS=30

ML_TRAIN_ENABLED=0
ML_DRIFT_MONITOR_ENABLED=0
SHADOW_OUTCOME_TRACKER_ENABLED=0
WORKER_SHADOW_TRACKER_ENABLED=0
ASSET_LEARNING_ENABLED=0
ANALYTICS_ML_TRAIN_ENABLED=0
ML_OFFLINE_BOOTSTRAP_ENABLED=0
PORTFOLIO_EXPOSURE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_MIN_TRADES=30
ASSET_REPEAT_LOCK_REQUIRE_DELIVERED=1
RESEND_SKIP_WHEN_CRITICAL_DB_ACTIVE=0
DB_BACKGROUND_JOBS_SKIP_WHEN_CRITICAL_ACTIVE=0
ML_ARCHIVE_BACKFILL_ENABLED=0
ASSET_UNIVERSE_BACKGROUND_REFRESH_ENABLED=0
FREE_RANDOM_DISTRIBUTION_ENABLED=0
REJECTION_DB_BATCH_SIZE=50
REJECTION_DB_FLUSH_SECONDS=2
REJECTION_DB_TIMEOUT_SECONDS=0.5
REJECTION_SPOOL_MAX_ITEMS=5000
WAITLIST_DB_TIMEOUT_SECONDS=0.5

# Additional optional market-data providers. Keep blank unless the adapter is enabled.
EODHD_API_KEY=
EODHD_API_TOKEN=
MARKETSTACK_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
NASDAQ_DATA_LINK_API_KEY=
NASDAQ_DATA_LINK_DATASETS_JSON=

# Proof-backed same-asset delivery policy
ASSET_REPEAT_LOCK_HOURS=4
DELIVERY_SAME_ASSET_COOLDOWN_HOURS=4
COOLDOWN_PREFLIGHT_FAIL_OPEN=0
# Deployment diagnostics and safe network defaults
CRYPTO_WS_ENABLED=0
PROXY_VALIDATION_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENABLED=1
DEPLOYMENT_DIAGNOSTICS_LIVE_PROVIDERS=0
DEPLOYMENT_FULL_TESTS_ENABLED=0
DEPLOYMENT_EXTENDED_SCANS_ENABLED=0
DEPLOYMENT_MUTATION_TESTS_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENDPOINT_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_REPORT_PATH=/tmp/signalrank_deployment_diagnostics.json
# Set and seal before enabling the endpoint:
DEPLOYMENT_DIAGNOSTICS_KEY=
DEPLOYMENT_TEST_CHAT_ID=
DEPLOYMENT_TELEGRAM_SEND_TEST=0
