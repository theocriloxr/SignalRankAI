# Hermetic local/CI profile. Uses no live external service and never moves money.
APP_ENV=test
RUN_MODE=test
PUBLIC_TESTING_MODE=1
RAILWAY_ENVIRONMENT_NAME=local-test
DATABASE_URL=sqlite+aiosqlite:///./.pytest-tmp/signalrank_test.db
REDIS_URL=
DELIVERY_REDIS_URL=
STATE_REDIS_URL=
TELEGRAM_BOT_TOKEN=0000000000:TEST_TOKEN_DO_NOT_USE
OWNER_TELEGRAM_ID=100001
OWNER_IDS=100001
ADMIN_IDS=100001
WEBHOOK_DOMAIN=https://example.invalid
TELEGRAM_WEBHOOK_SECRET=test-webhook-secret

AUTO_MIGRATE=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_PAYOUTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
PAYMENTS_PUBLIC_TEST_MODE=1
AUTOMATON_MODE=SIMULATION
CODEXOPS_MODE=READ_ONLY_AUDIT
MT5_ENABLED=0
WS_INGEST_ENABLED=0

DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
DB_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=1
DB_POOL_TIMEOUT_SECONDS=5
DB_AUXILIARY_NULLPOOL=1
DB_POOL_DISABLE_RAILWAY_CAP=0
DB_POOL_ALLOW_UNCAPPED_RAILWAY=0

MARKET_FETCH_ASSET_CONCURRENCY=2
MARKET_CACHE_FETCH_CONCURRENCY=2
COINBASE_OHLC_MAX_CONCURRENCY=2
OKX_OHLC_MAX_CONCURRENCY=2
BYBIT_OHLC_MAX_CONCURRENCY=1
YFINANCE_OHLC_MAX_CONCURRENCY=1
OHLC_PROVIDER_REQUEST_TIMEOUT_SECONDS=2
OHLC_REQUIRED_ASSET_TIMEOUT_SECONDS=5
OHLC_OPTIONAL_ASSET_TIMEOUT_SECONDS=3
OHLC_ENGINE_BATCH_TIMEOUT_SECONDS=12
OHLC_MAX_PROVIDER_ATTEMPTS_PER_TIMEFRAME=2
OHLC_ORPHAN_TASK_GUARD_ENABLED=1
DEFAULT_TRADING_STYLE=day

FINAL_SEND_LIVE_PRICE_CHECK_ENABLED=1
FINAL_SEND_FORCE_FRESH_PRICE=1
DELIVERY_REQUIRE_LIVE_PRICE=1
DELIVERY_FRESHNESS_TIMEOUT_FAIL_OPEN=0
DELIVERY_FRESHNESS_ERROR_FAIL_OPEN=0
DELIVERY_MISSING_PRICE_FAIL_OPEN=0
OUTCOME_TRACK_DELIVERED_ONLY=1
WORKER_OUTCOME_TRACKER_ENABLED=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
REALTIME_OUTCOME_TRACKER_ENABLED=1
SEND_OUTCOME_NOTIFICATIONS_ENABLED=1
SHADOW_OUTCOME_TRACKER_ENABLED=0
FREE_RANDOM_DISTRIBUTION_ENABLED=0

ENABLE_NEWS=0
ENABLE_ML=0
GEMINI_API_KEY=
NEWS_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
OANDA_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

LOG_JSON=0
OBSERVABILITY_METRICS_ENABLED=1
DECISION_LOG_WRITE_ENABLED=1
REJECTION_LOG_WRITE_ENABLED=1
# Provider request coordination
OHLC_PROVIDER_QUEUE_TIMEOUT_SECONDS=10
OHLC_INFLIGHT_WAIT_TIMEOUT_SECONDS=25
OHLC_DEFAULT_PROVIDER_MAX_CONCURRENCY=1
BINANCE_OHLC_MAX_CONCURRENCY=1
TWELVEDATA_OHLC_MAX_CONCURRENCY=1
POLYGON_OHLC_MAX_CONCURRENCY=1
FMP_OHLC_MAX_CONCURRENCY=1
OANDA_OHLC_MAX_CONCURRENCY=1
TRADINGVIEW_OHLC_MAX_CONCURRENCY=1
TIINGO_OHLC_MAX_CONCURRENCY=1
ALPHAVANTAGE_OHLC_MAX_CONCURRENCY=1

# Webhook and delivery queue safety
WEBHOOK_REDIS_QUEUE_ENABLED=0
WEBHOOK_UPDATE_WORKERS=4
WEBHOOK_UPDATE_QUEUE_SIZE=100
REDIS_WEBHOOK_QUEUE_MAX_DEPTH=5000
BROADCASTER_MAX_PARALLEL=25
BROADCASTER_MAX_RETRIES=3
DELIVERY_RECONCILE_BATCH_SIZE=100
DELIVERY_RECONCILE_INTERVAL_SECONDS=30

