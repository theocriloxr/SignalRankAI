# SignalRankAI canonical Railway staging variables
# Copy variable names into Railway. Keep secret values in Railway Variables only.
# This profile is for owner/internal testing and cannot activate real trading or payouts.

# Canonical Railway staging profile. Supply real staging secrets in Railway UI.
APP_ENV=staging
RUN_MODE=all
PUBLIC_TESTING_MODE=1
RAILWAY_ENVIRONMENT_NAME=staging

# Required secrets/references (set in Railway, do not commit values)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
DELIVERY_REDIS_URL=${{Redis.REDIS_URL}}
STATE_REDIS_URL=${{Redis.REDIS_URL}}
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
OWNER_IDS=
ADMIN_IDS=
WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_SECRET=
ENCRYPTION_KEY=

AUTO_MIGRATE=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_PAYOUTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
PAYMENTS_PUBLIC_TEST_MODE=1
AUTOMATON_MODE=SIMULATION
CODEXOPS_MODE=READ_ONLY_AUDIT
WS_INGEST_ENABLED=0

DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
DB_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=1
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=1
DB_AUXILIARY_NULLPOOL=1
DB_POOL_DISABLE_RAILWAY_CAP=0
DB_POOL_ALLOW_UNCAPPED_RAILWAY=0

MARKET_FETCH_ASSET_CONCURRENCY=2
MARKET_CACHE_FETCH_CONCURRENCY=2
COINBASE_OHLC_MAX_CONCURRENCY=2
OKX_OHLC_MAX_CONCURRENCY=2
BYBIT_OHLC_MAX_CONCURRENCY=1
YFINANCE_OHLC_MAX_CONCURRENCY=1
OHLC_PROVIDER_REQUEST_TIMEOUT_SECONDS=7
OHLC_REQUIRED_ASSET_TIMEOUT_SECONDS=20
OHLC_OPTIONAL_ASSET_TIMEOUT_SECONDS=12
OHLC_ENGINE_BATCH_TIMEOUT_SECONDS=50
OHLC_MAX_PROVIDER_ATTEMPTS_PER_TIMEFRAME=2
OHLC_ORPHAN_TASK_GUARD_ENABLED=1
DEFAULT_TRADING_STYLE=day
CRYPTO_MARKET_DATA_PROVIDERS=coinbase,okx,bybit
CRYPTO_PREFERRED_PROVIDER=coinbase
YFINANCE_CRYPTO_PRIMARY_ENABLED=0
BINANCE_MARKET_DATA_ENABLED=0

ENGINE_CYCLE_SLEEP_SECONDS=30
ENGINE_UNIVERSE_CAP=20
CYCLE_BATCH_SIZE=6
ALL_ASSET_TESTING_MODE=1
ALL_ASSET_MODE=1
ASSET_CLASSES_ENABLED=crypto,fx,index,commodity,stock

FINAL_SEND_LIVE_PRICE_CHECK_ENABLED=1
FINAL_SEND_FORCE_FRESH_PRICE=1
FINAL_SEND_LIVE_PRICE_TIMEOUT_SECONDS=4
FINAL_SEND_LIVE_PRICE_MAX_CACHE_SECONDS=10
DELIVERY_REQUIRE_LIVE_PRICE=1
DELIVERY_FRESHNESS_TIMEOUT_FAIL_OPEN=0
DELIVERY_FRESHNESS_ERROR_FAIL_OPEN=0
DELIVERY_MISSING_PRICE_FAIL_OPEN=0
DELIVERY_SIGNAL_UPDATE_ENABLED=0

WORKER_OUTCOME_TRACKER_ENABLED=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
REALTIME_OUTCOME_TRACKER_ENABLED=1
SEND_OUTCOME_NOTIFICATIONS_ENABLED=1
OUTCOME_TRACK_DELIVERED_ONLY=1
SHADOW_OUTCOME_TRACKER_ENABLED=1
FREE_RANDOM_DISTRIBUTION_ENABLED=0

ENGINE_DELIVERY_ASYNC_FANOUT=1
TELEGRAM_BROADCAST_RPS=25
TELEGRAM_ALLOW_PAID_BROADCAST=0
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_RETRY_AFTER_MAX_SECONDS=60
DELIVERY_TRACE_ENABLED=1
TELEGRAM_SEND_SUCCESS_LOG_ENABLED=1
CALLBACK_FAST_ACK_ENABLED=1

ENABLE_NEWS=1
ENABLE_ML=1
GEMINI_SIGNAL_REVIEW_CIRCUIT_BREAKER_ENABLED=1
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=900
GEMINI_SIGNAL_REVIEW_MAX_CALLS_PER_WINDOW=3
GEMINI_SIGNAL_REVIEW_TIMEOUT_SEC=4

OBSERVABILITY_METRICS_ENABLED=1
LOG_JSON=1
# Provider request coordination
OHLC_PROVIDER_QUEUE_TIMEOUT_SECONDS=10
OHLC_INFLIGHT_WAIT_TIMEOUT_SECONDS=25
OHLC_DEFAULT_PROVIDER_MAX_CONCURRENCY=1
BINANCE_OHLC_MAX_CONCURRENCY=1
TWELVEDATA_OHLC_MAX_CONCURRENCY=1
POLYGON_OHLC_MAX_CONCURRENCY=1
FMP_OHLC_MAX_CONCURRENCY=1
OANDA_OHLC_MAX_CONCURRENCY=1
TRADINGVIEW_OHLC_MAX_CONCURRENCY=1
TIINGO_OHLC_MAX_CONCURRENCY=1
ALPHAVANTAGE_OHLC_MAX_CONCURRENCY=1

# Webhook and delivery queue safety
WEBHOOK_REDIS_QUEUE_ENABLED=1
WEBHOOK_UPDATE_WORKERS=8
WEBHOOK_UPDATE_QUEUE_SIZE=2000
REDIS_WEBHOOK_QUEUE_MAX_DEPTH=5000
BROADCASTER_MAX_PARALLEL=25
BROADCASTER_MAX_RETRIES=3
DELIVERY_RECONCILE_BATCH_SIZE=100
DELIVERY_RECONCILE_INTERVAL_SECONDS=30
# Optional provider credentials (leave blank to disable that provider)
GEMINI_API_KEY=
NEWS_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
OANDA_API_KEY=
TIINGO_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
MT5_TOKEN=

# Explicit safety aliases checked by multiple subsystems
PAYMENTS_ENABLED=0
CHAT_MT5_CREDENTIALS_ENABLED=0
TELEGRAM_RICH_MESSAGES_ENABLED=0
VIP_WEBHOOK_DISPATCH_ENABLED=0
RUN_DB_MIGRATIONS_AT_BOOT=false
INSTALL_AT_BOOT=false
ALLOW_DOTENV=false
# Deployment diagnostics and safe network defaults
CRYPTO_WS_ENABLED=0
PROXY_VALIDATION_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENABLED=1
DEPLOYMENT_DIAGNOSTICS_LIVE_PROVIDERS=0
DEPLOYMENT_FULL_TESTS_ENABLED=0
DEPLOYMENT_EXTENDED_SCANS_ENABLED=0
DEPLOYMENT_MUTATION_TESTS_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENDPOINT_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_REPORT_PATH=/tmp/signalrank_deployment_diagnostics.json
# Set and seal before enabling the endpoint:
DEPLOYMENT_DIAGNOSTICS_KEY=
DEPLOYMENT_TEST_CHAT_ID=
DEPLOYMENT_TELEGRAM_SEND_TEST=0

# v1.0.8 operational contention and Telegram UX controls
TELEGRAM_RICH_MESSAGES_CERTIFIED=0
MONITOR_REFRESH_ENABLED=1
MONITOR_REFRESH_LIMIT=100
MONITOR_REFRESH_CONCURRENCY=4
MONITOR_REFRESH_DB_TIMEOUT_SECONDS=2
MONITOR_REFRESH_SNAPSHOT_TIMEOUT_SECONDS=8
MONITOR_REFRESH_TELEGRAM_TIMEOUT_SECONDS=10
MONITOR_REFRESH_JOB_TIMEOUT_SECONDS=45
RESEND_AUDIENCE_ALLOWLIST_ONLY=0
RESEND_MAX_USERS_PER_RUN=25
RESEND_JOB_TIMEOUT_SECONDS=90
ENGINE_PULSE_DISTRIBUTED_LOCK_ENABLED=1
ENGINE_PULSE_LOCK_TTL_SECONDS=3570
ENGINE_PULSE_LOCK_KEY=signalrank:admin_pulse:hourly
PROVIDER_RECOVERY_REQUIRED_SUCCESSES=3
PROVIDER_RECOVERY_STABLE_SECONDS=120
