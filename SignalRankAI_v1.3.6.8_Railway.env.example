# SignalRankAI v1.3.6.8 — Railway safe staging baseline
# Copy through Railway variables. Never commit real secrets.
APP_VERSION=1.3.6.8
APP_ENV=staging
DECOMPOSED_TOPOLOGY_ENABLED=1
ALLOW_STATIC_ASSET_FALLBACK=0
AUTO_DISCOVERY_ALL_PROVIDERS=1
ASSET_UNIVERSE_BACKGROUND_REFRESH_ENABLED=1
ASSET_UNIVERSE_REFRESH_INTERVAL_SECONDS=900
PROFILE_DRIVEN_UNIVERSE_ENABLED=1
PROFILE_DRIVEN_TIMEFRAMES_ENABLED=1
PROFILE_DEMAND_CACHE_SECONDS=120
PROFILE_POLICY_FAIL_CLOSED=1
DELIVERY_LIMIT_FAIL_CLOSED=1
DELIVERY_PRICE_VALIDATION_FAIL_CLOSED=1

# Canonical thesis and same-user asset deduplication.
SIGNAL_THESIS_DEDUP_HOURS=4
SIGNAL_THESIS_ENTRY_BAND_PCT=0.003
SIGNAL_SEMANTIC_ENTRY_TOLERANCE_PCT=0.003
THESIS_FINGERPRINT_INCLUDE_REGIME=0
THESIS_FINGERPRINT_INCLUDE_TIMEFRAME=0
ASSET_REPEAT_LOCK_HOURS=4
ASSET_REPEAT_LOCK_REQUIRE_DELIVERED=1
ALLOW_TIER_ASSET_COOLDOWN_OVERRIDES=0
ALLOW_ASSET_COOLDOWN_REDUCTION=0
OUTCOME_DUPLICATE_NOTIFICATION_SUPPRESSION_ENABLED=1

# Purpose-specific freshness.
DELIVERY_REQUIRE_GENERATED_AT=1
PAPER_REQUIRE_GENERATED_AT=1
LIVE_REQUIRE_GENERATED_AT=1
COPY_REQUIRE_GENERATED_AT=1
PAPER_MAX_SIGNAL_AGE_5M_SECONDS=300
PAPER_MAX_SIGNAL_AGE_15M_SECONDS=600
PAPER_MAX_SIGNAL_AGE_1H_SECONDS=1800
PAPER_MAX_SIGNAL_AGE_4H_SECONDS=5400
PAPER_MAX_SIGNAL_AGE_1D_SECONDS=21600

# Paper portfolio controls and recovery.
PAPER_MAX_ENTRY_DEVIATION_BPS=25
PAPER_MAX_OPEN_POSITIONS_PER_ASSET_CLASS=2
PAPER_MAX_TOTAL_EXPOSURE_PCT=80
PAPER_MAX_NOTIONAL_PCT=20
PAPER_MAX_DAILY_LOSS_PCT=5
PAPER_MAX_OPEN_RISK_PCT=3
PAPER_CLOSE_ALL_LAST_MARK_MAX_AGE_SECONDS=300

# Partial-exit accounting and historical repair.
SIGNAL_TP1_CLOSE_FRACTION=0.50
SIGNAL_TP2_CLOSE_FRACTION=0.25
PARTIAL_EXIT_REPAIR_DAYS=365
PARTIAL_EXIT_REPAIR_LIMIT=2000

# Outcome notification lifecycle.
OUTCOME_NOTIFICATION_JOB_BUDGET_SECONDS=45
OUTCOME_NOTIFICATION_HISTORICAL_AFTER_SECONDS=300
OUTCOME_NOTIFICATION_FETCH_MARKET_PRICE_FALLBACK=0
OUTCOME_NOTIFICATION_PRICE_TIMEOUT_SECONDS=3

# Outcome/performance truth.
OUTCOME_RECONCILIATION_ENABLED=1
OUTCOME_RECONCILIATION_INTERVAL_SECONDS=60
OUTCOME_RECONCILIATION_STARTUP_DELAY_SECONDS=5
OUTCOME_RECONCILIATION_LIMIT=5000
OUTCOME_PROJECTION_MIN_COVERAGE=0.99
PERFORMANCE_LEDGER_MIN_PROJECTION_COVERAGE=0.99
PERFORMANCE_CERTIFIED_MIN_TERMINAL_COVERAGE=0.95
PUBLIC_WIN_RATE_CLAIM_TARGET=0.60
PUBLIC_CLAIM_MIN_TERMINAL_SAMPLE=200
PUBLIC_CLAIM_MIN_UNIQUE_THESES=100
PUBLIC_CLAIM_MIN_TERMINAL_COVERAGE=0.95

# ML safety.
ML_MIN_PROMOTION_AUC=0.60
ML_MIN_PROMOTION_ACCURACY=0.55
ML_PROMOTION_REQUIRES_VALID_CALIBRATION=1
ML_MIN_CALIBRATION_VALIDATION_ROWS=100
ML_PUBLIC_CALIBRATION_METRICS_REQUIRED=1
ML_MAX_CALIBRATION_BRIER=0.25
ML_MAX_CALIBRATION_ECE=0.10
ML_PROBABILITY_DISPLAY_REQUIRES_CALIBRATION=1
LIVE_EXECUTION_REQUIRES_CALIBRATED_ML=1
LIVE_EXECUTION_REQUIRES_PROVIDER_DISCOVERY=1

# Certification IDs remain blank until supported by reviewed runtime evidence.
PRODUCTION_INTEGRITY_CERTIFIED=0
PRODUCTION_INTEGRITY_CERTIFICATION_ID=
LIVE_RUNTIME_CERTIFICATION_ID=
ML_CALIBRATION_ARTIFACT_ID=
COPY_TRADING_CERTIFICATION_ID=
ASSET_DISCOVERY_CERTIFICATION_ID=
FRESHNESS_CERTIFICATION_ID=
PROFILE_ROUTING_CERTIFICATION_ID=
PAPER_TRADING_CERTIFICATION_ID=
OUTCOME_TRACKER_CERTIFICATION_ID=
PERFORMANCE_TRUTH_CERTIFICATION_ID=

# Live/copy/public financial switches remain fail-closed.
AUTO_EXECUTION_ENABLED=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_EXECUTION_ENABLED=0
PUBLIC_WIN_RATE_MARKETING_ENABLED=0
GLOBAL_EXECUTION_KILL_SWITCH=1

# v1.3.6.8 bounded, resumable performance projection.
PERFORMANCE_RECONCILIATION_DAYS=365
PERFORMANCE_RECONCILIATION_USER_LIMIT=250
PERFORMANCE_RECONCILIATION_MAX_ATTEMPTS=5
PERFORMANCE_OWNER_REBUILD_LIMIT=100

# 100k architecture foundation is code-present but intentionally disabled until
# the v1.3.6.8 runtime gate and capacity tests pass.
DURABLE_EVENT_STREAM_ENABLED=0
DURABLE_EVENT_STREAM_PARTITIONS=32
DURABLE_EVENT_STREAM_MAXLEN=1000000
DURABLE_EVENT_DLQ_MAXLEN=100000
EVENT_REDIS_MAX_CONNECTIONS=48
EVENT_REDIS_URL=

# Staging SLO gates.
WEBHOOK_ACK_P95_MS=500
WEBHOOK_ACK_P99_MS=1000
QUALIFIED_SIGNAL_DELIVERY_P95_MS=5000
NOTIFICATION_QUEUE_AGE_P99_SECONDS=60
PERFORMANCE_PROJECTION_TARGET_COVERAGE=0.999

# Do not activate these until separately certified.
UNIVERSAL_PROVIDER_ROUTING_ENABLED=0
HYPERLIQUID_EXECUTION_ENABLED=0
DYDX_EXECUTION_ENABLED=0
KRAKEN_EXECUTION_ENABLED=0
IBKR_EXECUTION_ENABLED=0
OANDA_EXECUTION_ENABLED=0
ALPACA_EXECUTION_ENABLED=0
