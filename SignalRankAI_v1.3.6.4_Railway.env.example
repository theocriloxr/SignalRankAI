# SignalRankAI v1.3.6.4 runtime-stability hotfix
# Application code version remains 1.3.6.
APP_VERSION=1.3.6

# Front-door scheduler ownership and bounded work
RESEND_UNSENT_JOB_ENABLED=1
RESEND_UNSENT_INTERVAL_SECONDS=60
RESEND_UNSENT_STARTUP_DELAY_SECONDS=20
RESEND_JOB_TIMEOUT_SECONDS=25
RESEND_JOB_BUDGET_SECONDS=20
RESEND_JOB_LEASE_SECONDS=45
RESEND_CANDIDATE_QUERY_LIMIT=50
RESEND_MAX_USERS_PER_RUN=6
RESEND_MAX_SIGNALS=3
RESEND_INTER_SEND_DELAY_SECONDS=0.10
RESEND_SKIP_WHEN_CRITICAL_DB_ACTIVE=1
RESEND_SKIP_WHEN_ENGINE_FANOUT_ACTIVE=0

SEND_OUTCOME_NOTIFICATIONS_ENABLED=1
OUTCOME_NOTIFICATION_INTERVAL_SECONDS=90
OUTCOME_NOTIFICATION_STARTUP_DELAY_SECONDS=25
OUTCOME_NOTIFICATION_JOB_BUDGET_SECONDS=20
OUTCOME_NOTIFICATION_JOB_LEASE_SECONDS=45
OUTCOME_NOTIFICATION_MAX_OUTCOMES_PER_RUN=5
OUTCOME_NOTIFICATION_INTER_SEND_DELAY_SECONDS=0.05

MONITOR_REFRESH_INTERVAL_SECONDS=120
DB_BACKGROUND_JOBS_SKIP_WHEN_CRITICAL_ACTIVE=1

# Public front-door URLs (replace with the active domain)
WEBHOOK_DOMAIN=https://bountiful-miracle-staging.up.railway.app
WEBHOOK_URL=https://bountiful-miracle-staging.up.railway.app
PUBLIC_BASE_URL=https://bountiful-miracle-staging.up.railway.app
APP_BASE_URL=https://bountiful-miracle-staging.up.railway.app

# Trusted FX/metals coverage: configure at least one path.
# Preferred broker-native path:
META_API_MARKET_DATA_ACCOUNT_ID=<dedicated-metaapi-account-id>
# META_API_TOKEN is a secret and must be set in Railway, not committed here.

# Alternatives (secrets must be set in Railway):
# OANDA_ACCOUNT_ID=<oanda-account-id>
# OANDA_API_KEY=<secret>
# TWELVEDATA_API_KEY=<secret>
# FCS_API_KEY=<secret>

# Enabled classes checked by /readyz provider_coverage.
ENABLED_ASSET_CLASSES=crypto,fx,stock,index,commodity
