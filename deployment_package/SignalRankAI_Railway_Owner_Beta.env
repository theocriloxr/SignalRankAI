# ============================================================================
# SignalRankAI V7.1 — Railway owner-beta / Telegram recovery profile
# Paste into the APPLICATION service's Railway Variables > RAW Editor.
# Replace every <...> placeholder before deploying.
# Service references assume services are named: Postgres, RedisState, RedisDelivery.
# ============================================================================

# --- Environment and process ownership ---
APP_ENV=production
RUN_MODE=all
HONOR_RUN_MODE_ON_RAILWAY=false
PUBLIC_TESTING_MODE=0
DRY_RUN=0
AUTO_MIGRATE=0
STARTUP_SCHEMA_BOOTSTRAP=0
STARTUP_STRICT_SCHEMA_READY=0
RUN_DB_MIGRATIONS_AT_BOOT=false
INSTALL_AT_BOOT=false
ALLOW_DOTENV=false
RUN_ENGINE_LOOP=0
RUN_WORKER_LOOP=1
UVICORN_WORKERS=1
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30

# --- PostgreSQL ---
# Initial direct-Postgres deployment:
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Always direct Postgres; Alembic prefers this variable.
DATABASE_MIGRATION_URL=${{Postgres.DATABASE_URL}}
DB_USE_NULLPOOL=0
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=1
DB_CONNECT_TIMEOUT=15
DB_COMMAND_TIMEOUT=45
DB_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=1
DB_INTERACTIVE_SESSION_GATE_TIMEOUT_SECONDS=0.75
DB_CRITICAL_SESSION_GATE_TIMEOUT_SECONDS=5
DB_BACKGROUND_SESSION_GATE_TIMEOUT_SECONDS=2
DB_ANALYTICS_SESSION_GATE_TIMEOUT_SECONDS=0
DB_SESSION_HOLD_WARN_SECONDS=5
DB_AUXILIARY_NULLPOOL=1
DB_POOL_DISABLE_RAILWAY_CAP=0
DB_POOL_ALLOW_UNCAPPED_RAILWAY=0

# --- Redis: these MUST resolve to two different services ---
REDIS_URL=${{RedisState.REDIS_URL}}
STATE_REDIS_URL=${{RedisState.REDIS_URL}}
DELIVERY_REDIS_URL=${{RedisDelivery.REDIS_URL}}
REQUIRE_DISTINCT_DELIVERY_REDIS=1
ALLOW_SHARED_REDIS_FOR_DEV=0
REDIS_MAX_CONNECTIONS=24

# --- Required application secrets and identities ---
TELEGRAM_BOT_TOKEN=<PASTE_BOTFATHER_TOKEN>
TELEGRAM_WEBHOOK_SECRET=<GENERATE_VALID_WEBHOOK_SECRET>
OWNER_TELEGRAM_ID=<YOUR_NUMERIC_TELEGRAM_ID>
OWNER_IDS=<YOUR_NUMERIC_TELEGRAM_ID>
ADMIN_IDS=<YOUR_NUMERIC_TELEGRAM_ID>
ENCRYPTION_KEY=<GENERATE_FERNET_KEY>
API_TOKEN_PEPPER=<GENERATE_RANDOM_PEPPER>

# Railway supplies RAILWAY_PUBLIC_DOMAIN after you generate a public domain.
WEBHOOK_DOMAIN=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
TELEGRAM_USE_WEBHOOK=1

# --- Telegram webhook ingress and message recovery ---
TELEGRAM_ALLOWED_UPDATES=message,edited_message,callback_query,my_chat_member,chat_member,pre_checkout_query,shipping_query
TELEGRAM_DROP_PENDING_UPDATES_ON_STARTUP=0
TELEGRAM_DELETE_WEBHOOK_ON_SHUTDOWN=0
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=20
BOT_APP_DISCOVERY_TIMEOUT_SECONDS=120
BOT_WEBHOOK_READY_MIN_HANDLERS=60
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_SOFT_TIMEOUT_SECONDS=30
WEBHOOK_HARD_TIMEOUT_SECONDS=120
WEBHOOK_REDIS_QUEUE_ENABLED=1
WEBHOOK_UPDATE_WORKERS=4
WEBHOOK_UPDATE_QUEUE_SIZE=1000
REDIS_WEBHOOK_QUEUE_MAX_DEPTH=2000
TELEGRAM_UPDATES_STREAM=signalrank:telegram_updates:v1
TELEGRAM_UPDATES_CONSUMER_GROUP=signalrank:telegram
TELEGRAM_UPDATES_DLQ_STREAM=signalrank:telegram_updates:dead_letter:v1

# --- Telegram outbound replies, broadcasts and buttons ---
CALLBACK_FAST_ACK_ENABLED=1
TELEGRAM_RICH_MESSAGES_ENABLED=0
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_RETRY_AFTER_MAX_SECONDS=60
TELEGRAM_SEND_TIMEOUT_SECONDS=12
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_READ_TIMEOUT=30
TELEGRAM_WRITE_TIMEOUT=30
TELEGRAM_POOL_TIMEOUT=30
TELEGRAM_GLOBAL_SEND_DELAY_SECONDS=0.08
TELEGRAM_BROADCAST_RPS=20
TELEGRAM_ALLOW_PAID_BROADCAST=0
TELEGRAM_SEND_SUCCESS_LOG_ENABLED=1
BROADCASTER_MAX_PARALLEL=10
BROADCASTER_MAX_RETRIES=3
DELIVERY_RECONCILE_BATCH_SIZE=100
DELIVERY_RECONCILE_INTERVAL_SECONDS=30

# --- Safe owner-only market-data profile ---
ALL_ASSET_MODE=0
ALL_ASSET_TESTING_MODE=0
CRYPTO_ONLY_MODE=1
ASSET_CLASSES_ENABLED=crypto
CRYPTO_MARKET_DATA_PROVIDERS=coinbase,okx
CRYPTO_PREFERRED_PROVIDER=coinbase
BINANCE_MARKET_DATA_ENABLED=0
WS_INGEST_ENABLED=0
CRYPTO_WS_ENABLED=0
ENGINE_UNIVERSE_CAP=12
CYCLE_BATCH_SIZE=4
ENGINE_CYCLE_SLEEP_SECONDS=30
MARKET_FETCH_ASSET_CONCURRENCY=2
MARKET_CACHE_FETCH_CONCURRENCY=2
COINBASE_OHLC_MAX_CONCURRENCY=2
OKX_OHLC_MAX_CONCURRENCY=2
BYBIT_OHLC_MAX_CONCURRENCY=1
YFINANCE_OHLC_MAX_CONCURRENCY=1
OHLC_PROVIDER_REQUEST_TIMEOUT_SECONDS=7
OHLC_PROVIDER_QUEUE_TIMEOUT_SECONDS=10
OHLC_INFLIGHT_WAIT_TIMEOUT_SECONDS=25
OHLC_REQUIRED_ASSET_TIMEOUT_SECONDS=20
OHLC_OPTIONAL_ASSET_TIMEOUT_SECONDS=12
OHLC_ENGINE_BATCH_TIMEOUT_SECONDS=50
OHLC_MAX_PROVIDER_ATTEMPTS_PER_TIMEFRAME=2
OHLC_ORPHAN_TASK_GUARD_ENABLED=1
DEFAULT_TRADING_STYLE=day

# --- Delivery proof, lifecycle, outcomes and repeat protection ---
FINAL_SEND_LIVE_PRICE_CHECK_ENABLED=1
FINAL_SEND_FORCE_FRESH_PRICE=1
FINAL_SEND_LIVE_PRICE_TIMEOUT_SECONDS=4
FINAL_SEND_LIVE_PRICE_MAX_CACHE_SECONDS=10
DELIVERY_REQUIRE_LIVE_PRICE=1
DELIVERY_FRESHNESS_TIMEOUT_FAIL_OPEN=0
DELIVERY_FRESHNESS_ERROR_FAIL_OPEN=0
DELIVERY_MISSING_PRICE_FAIL_OPEN=0
DELIVERY_SIGNAL_UPDATE_ENABLED=0
OUTCOME_TRACK_DELIVERED_ONLY=1
WORKER_OUTCOME_TRACKER_ENABLED=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
REALTIME_OUTCOME_TRACKER_ENABLED=1
SEND_OUTCOME_NOTIFICATIONS_ENABLED=1
PORTFOLIO_EXPOSURE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_REQUIRE_DELIVERED=1
SEGMENT_QUARANTINE_MIN_TRADES=30
ASSET_REPEAT_LOCK_REQUIRE_DELIVERED=1
ASSET_REPEAT_LOCK_HOURS=4
DELIVERY_SAME_ASSET_COOLDOWN_HOURS=4
COOLDOWN_PREFLIGHT_FAIL_OPEN=0
FREE_RANDOM_DISTRIBUTION_ENABLED=0
FREE_SIGNAL_DISTRIBUTION_ENABLED=0
TELEGRAM_ALLOW_PAID_BROADCAST=0

# --- Heavy/optional intelligence disabled for first recovery deploy ---
ENABLE_NEWS=0
ENABLE_ML=0
ML_OFFLINE_BOOTSTRAP_ENABLED=0
ML_TRAIN_ENABLED=0
ANALYTICS_ML_TRAIN_ENABLED=0
ML_DRIFT_MONITOR_ENABLED=0
ML_ARCHIVE_BACKFILL_ENABLED=0
ASSET_LEARNING_ENABLED=0
ASSET_UNIVERSE_BACKGROUND_REFRESH_ENABLED=0
SHADOW_OUTCOME_TRACKER_ENABLED=0
WORKER_SHADOW_TRACKER_ENABLED=0

# --- Trading/payment safety gates: keep all OFF ---
PAPER_MODE=0
PAYMENTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
PAYMENTS_PUBLIC_TEST_MODE=1
REAL_PAYOUTS_ENABLED=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_EXECUTION_ENABLED=0
MT5_ENABLED=0
MT5_DEMO_ONLY=1
MT5_ALLOW_LIVE_ACCOUNTS=0
CHAT_MT5_CREDENTIALS_ENABLED=0
AUTOMATON_MODE=SIMULATION
CODEXOPS_MODE=READ_ONLY_AUDIT

# --- Resource guard for one Railway application replica ---
RESOURCE_GUARD_ENABLED=1
APP_MEMORY_LIMIT_MB=0
APP_MEMORY_SOFT_RATIO=0.72
APP_MEMORY_HARD_RATIO=0.88
APP_MEMORY_CRITICAL_RATIO=0.96
APP_MEMORY_RECOVERY_MARGIN_MB=32
RESOURCE_RECOVERY_SAMPLES=3
RESOURCE_RECOVERY_HYSTERESIS_RATIO=0.10
RESOURCE_CPU_SOFT_PERCENT=75
RESOURCE_CPU_HARD_PERCENT=90
RESOURCE_CPU_CRITICAL_PERCENT=98
RESOURCE_EVENT_LOOP_SOFT_MS=100
RESOURCE_EVENT_LOOP_HARD_MS=500
RESOURCE_EVENT_LOOP_CRITICAL_MS=2000
RESOURCE_DB_QUEUE_SOFT=2
RESOURCE_DB_QUEUE_HARD=6
RESOURCE_DB_QUEUE_CRITICAL=12
RESOURCE_DB_WAIT_SOFT_MS=250
RESOURCE_DB_WAIT_HARD_MS=1000
RESOURCE_DB_WAIT_CRITICAL_MS=5000
RESOURCE_REDIS_SOFT_MS=50
RESOURCE_REDIS_HARD_MS=200
RESOURCE_REDIS_CRITICAL_MS=1000
RESOURCE_DELIVERY_QUEUE_SOFT_RATIO=0.60
RESOURCE_DELIVERY_QUEUE_HARD_RATIO=0.80
RESOURCE_DELIVERY_QUEUE_CRITICAL_RATIO=0.95
RESOURCE_PROVIDER_ERROR_SOFT_RATIO=0.10
RESOURCE_PROVIDER_ERROR_HARD_RATIO=0.30
RESOURCE_PROVIDER_ERROR_CRITICAL_RATIO=0.60
RESOURCE_RETRY_AFTER_SOFT_RATIO=0.02
RESOURCE_RETRY_AFTER_HARD_RATIO=0.10
RESOURCE_RETRY_AFTER_CRITICAL_RATIO=0.25
RESOURCE_PENDING_TASKS_SOFT=100
RESOURCE_PENDING_TASKS_HARD=300
RESOURCE_PENDING_TASKS_CRITICAL=1000

# --- Logs, metrics and deployment diagnostics ---
LOG_LEVEL=INFO
LOG_JSON=1
OBSERVABILITY_METRICS_ENABLED=1
PROXY_VALIDATION_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENABLED=1
DEPLOYMENT_DIAGNOSTICS_LIVE_PROVIDERS=0
DEPLOYMENT_FULL_TESTS_ENABLED=0
DEPLOYMENT_EXTENDED_SCANS_ENABLED=0
DEPLOYMENT_MUTATION_TESTS_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_ENDPOINT_ENABLED=0
DEPLOYMENT_DIAGNOSTICS_REPORT_PATH=/tmp/signalrank_deployment_diagnostics.json
DEPLOYMENT_TELEGRAM_SEND_TEST=0
DEPLOYMENT_TEST_CHAT_ID=<YOUR_NUMERIC_TELEGRAM_ID>
