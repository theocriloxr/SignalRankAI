DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signalrank_test
REDIS_URL=
TELEGRAM_BOT_TOKEN=
SENTRY_DSN=
NEWS_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=
FOREX_FACTORY_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
ECONOMIC_CALENDAR_CACHE_TTL_SECONDS=3600
ECONOMIC_CALENDAR_TIMEOUT_SECONDS=8
NO_TRADE_BUFFER_MINUTES=30
NEWS_VOLATILITY_BUFFER_MULTIPLIER=1.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional keyed market-data fallbacks. Bybit, OKX, Coinbase, Kraken,
# CoinGecko basic, and Yahoo public market-data paths do not require keys.
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=
CRYPTOCOMPARE_API_KEY=
COINGECKO_API_KEY=
FMP_API_KEY=
FCS_API_KEY=
TIINGO_API_KEY=
CRYPTO_PREFERRED_PROVIDER=okx
BINANCE_MARKET_DATA_ENABLED=0
YFINANCE_CRYPTO_PRIMARY_ENABLED=0
MARKET_PROVIDER_TIMEOUT_SECONDS=5
MARKET_TIMEFRAME_FETCH_TIMEOUT_SECONDS=15
MARKET_CACHE_WRITE_THROUGH=0
CRYPTO_ONLY_MODE=0
# Optional comma-separated gate, for example: crypto or crypto,fx
ASSET_CLASSES_ENABLED=
MARKET_ALTERNATIVE_SIGNALS_ENABLED=1
CRYPTO_MICROSTRUCTURE_PROVIDERS=okx,bybit
CRYPTO_DERIVATIVES_PROVIDERS=okx,bybit
ORDER_BOOK_IMBALANCE_THRESHOLD=1.5
SQUEEZE_FUNDING_THRESHOLD=0.0005
XGBOOST_MODEL_PATH=
ML_MODEL_PATH=ml/model.json
RUN_MODE=all
PAPER_MODE=false
ENABLE_NEWS=true
ENABLE_ML=true
LOG_JSON=false
SENTRY_TRACES_SAMPLE_RATE=0.0
TELEGRAM_POOL_TIMEOUT=30
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_READ_TIMEOUT=30
TELEGRAM_WRITE_TIMEOUT=30

# Monolith hardening knobs
AUTO_MIGRATE=false
ENGINE_CYCLE_SLEEP_SECONDS=30
ENGINE_UNIVERSE_CAP=20
OUTCOME_CHECK_INTERVAL_SECONDS=20
OUTCOME_LIFECYCLE_ENABLED=1
LIFECYCLE_EVENT_NOTIFICATIONS_ENABLED=1
SIGNAL_ENTRY_GATING_ENABLED=1
SIGNAL_TIMEZONE_DISPLAY_ENABLED=1
LIFECYCLE_NOTIFICATION_RETRY_LIMIT=100
TRAVEL_TIMEZONE_REFRESH_DAYS=14
TIMEZONE_STORE_LOCATION_COORDINATES=0
TRAINING_R_CLIP_MIN=-5
TRAINING_R_CLIP_MAX=10
PERFORMANCE_BASELINE_VERSION=2
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_MAX_CONCURRENT_SESSIONS=4
DB_AUXILIARY_NULLPOOL=1
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_RETRY_ATTEMPTS=3

# Strategy and execution quality profile defaults
IMP_STRATEGY_ENABLED=1
IMP_ONLY_MODE=0
RUN_ALL_STRATEGIES=1
USE_FALLBACK_STRATEGIES=1
IMP_FX_SESSION_FILTER_ENABLED=1
IMP_FX_ALLOWED_SESSIONS=london,newyork,overlap
EXPECTANCY_HARD_BLOCK_ENABLED=0
OPEN_SIGNALS_MAX_PER_ASSET=20
OPEN_SIGNALS_MAX_PER_CLASS=20

# Production signal quality and exposure controls
SIGNAL_SCORE_MIN=92
SIGNAL_SCORE_HARD_REJECT=85
SCORE_SOFT_CAP_ENABLED=1
SCORE_DISPLAY_MAX=99.5
SCORE_ALLOW_HARD_100=0
ASSET_REPEAT_LOCK_HOURS=12
DELIVERY_UNRESOLVED_BLOCK_HOURS=168
ACTIVE_SIGNAL_MAX_PER_USER=10
ACTIVE_SIGNAL_MAX_PER_ASSET=1
AI_CONSENSUS_MIN=0.85
AI_DISAGREEMENT_MAX=0.20
NEWS_BLACKOUT_MINUTES=30
PORTFOLIO_EXPOSURE_ENABLED=1
CORRELATION_ENGINE_ENABLED=1
EXECUTION_ELIGIBILITY_ENABLED=1

# Provider, idempotency, and observability controls
PROVIDER_FAILOVER_ENABLED=1
PROVIDER_MAX_ERRORS=5
PROVIDER_COOLDOWN_SECONDS=300
OUTCOME_IDEMPOTENCY_ENABLED=1
TELEGRAM_IDEMPOTENCY_ENABLED=1
MT5_IDEMPOTENCY_ENABLED=1
OBSERVABILITY_METRICS_ENABLED=1
REPLAY_ENGINE_ENABLED=0
TRADE_PROFILE_ENGINE_ENABLED=1
SIGNAL_INTELLIGENCE_ENGINE_ENABLED=1
MARKET_INTELLIGENCE_HARD_BLOCK_ENABLED=0
TRADING_LEDGER_ENABLED=1
COMMAND_HANDLER_TIMEOUT_SECONDS=60
DB_POOL_PRE_PING=true
DB_USE_NULLPOOL=false
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
FREE_SIGNAL_DELAY_MINUTES=10
PREMIUM_SIGNAL_DELAY_MINUTES=0
VIP_SIGNAL_DELAY_MINUTES=0
