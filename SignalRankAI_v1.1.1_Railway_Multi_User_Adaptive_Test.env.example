# SignalRankAI v1.1.1 multi-user adaptive staging proof
APP_VERSION=1.1.1
PUBLIC_TESTING_MODE=1

# Start with 2-5 explicit beta Telegram IDs, comma separated.
DELIVERY_AUDIENCE_ALLOWLIST=1409578077
RESEND_AUDIENCE_ALLOWLIST_ONLY=1
RESEND_MAX_USERS_PER_RUN=25
RESEND_INCLUDE_FREE=1

ADAPTIVE_STRATEGY_ENGINE_ENABLED=1
ADAPTIVE_STRATEGY_GENERATION_ENABLED=1
ADAPTIVE_OPTIMISATION_ENABLED=1
ADAPTIVE_LEARNING_WORKER_ENABLED=1
ADAPTIVE_CANDLE_CAPTURE_ENABLED=1
# Enable only during owner/beta evidence collection; all candidates still pass
# existing score, risk, news, freshness, eligibility and deduplication gates.
ADAPTIVE_SHADOW_CANDIDATES_IN_SIGNAL_PIPELINE_ENABLED=1
ADAPTIVE_AUTO_PROMOTION_ENABLED=0
ADAPTIVE_REQUIRE_HUMAN_APPROVAL=1

SHADOW_OUTCOME_TRACKER_ENABLED=1
ALLOW_ANALYTICS_IN_WORKER=1
DEPLOYMENT_DIAGNOSTICS_LIVE_PROVIDERS=1

# REST remains authoritative; enable WS only after provider connectivity proves stable.
WS_INGEST_ENABLED=0
WS_CRYPTO_ENABLED=0
TRADINGVIEW_ENABLED=1
TRADINGVIEW_MAX_RETRIES=1
TRADINGVIEW_CACHE_TTL_SECONDS=300
TRADINGVIEW_RATE_LIMIT_COOLDOWN_SECONDS=300

# Unified delivery freshness policy.
FINAL_SEND_MAX_DRIFT_CRYPTO_PCT=0.50
FINAL_SEND_MAX_DRIFT_FOREX_PCT=0.12
FINAL_SEND_MAX_DRIFT_STOCK_PCT=0.35
FINAL_SEND_MAX_DRIFT_COMMODITY_PCT=0.30
FINAL_SEND_MAX_DRIFT_INDEX_PCT=0.25
DELIVERY_ENTRY_DRIFT_ATR_MULTIPLIER=0.50
FINAL_SEND_ABSOLUTE_MAX_DRIFT_CRYPTO_PCT=1.50
FINAL_SEND_ABSOLUTE_MAX_DRIFT_FOREX_PCT=0.40

# Keep unrestricted real-money/public financial paths disabled during testing.
REAL_EXECUTION_ENABLED=0
AUTO_EXECUTION_ENABLED=0
AUTO_TRADE_ENABLED=0
BYBIT_EXECUTION_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_PAYOUTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
MT5_ALLOW_LIVE_ACCOUNTS=0
# Deferred decision/evidence retention under DB pressure
DECISION_LOG_RETRY_ENABLED=1
DECISION_LOG_RETRY_INTERVAL_SECONDS=30
DECISION_LOG_RETRY_BATCH_SIZE=100
# Optional integration certification. Add real values in Railway, never source control.
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# TV_WEBHOOK_SECRET=
# PROXY_VALIDATION_PROVIDER_URL=
PROXY_VALIDATION_ENABLED=0

# Free-tier distribution stays off until the beta allowlist is verified.
FREE_SIGNAL_DISTRIBUTION_ENABLED=0
FREE_RANDOM_DISTRIBUTION_ENABLED=0

