# SignalRankAI v1.3.1 live-financial activation profile — secrets are supplied in Railway
# Deploy only in a Railway environment literally named production/prod.
APP_VERSION=1.3.1
APP_ENV=production

# Mandatory production service references and secrets. Replace every placeholder
# in Railway; never commit or paste real values into source control.
DATABASE_URL=<railway-postgres-private-url>
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<random-long-webhook-secret>
OWNER_TELEGRAM_ID=<numeric-owner-telegram-id>
GEMINI_API_KEY=<gemini-api-key>
ENCRYPTION_KEY=<strong-fernet-compatible-key>
META_API_TOKEN=<metaapi-token-for-user-linked-demo-mt5>

PUBLIC_TESTING_MODE=0
FULL_SYSTEM_STAGING_TEST_MODE=0
FULL_SYSTEM_STAGING_TEST_ACK=
DRY_RUN=0
AUTO_MIGRATE=0
RUN_DB_MIGRATIONS_AT_BOOT=0
UVICORN_WORKERS=1
OUTCOME_TRACK_DELIVERED_ONLY=1
REQUIRE_DISTINCT_DELIVERY_REDIS=1
STATE_REDIS_URL=<set-to-state-redis-private-url>
DELIVERY_REDIS_URL=<set-to-distinct-delivery-redis-private-url>

# Railway injects RAILWAY_PUBLIC_DOMAIN. Do not copy the old staging URL into
# WEBHOOK_DOMAIN, WEBHOOK_URL, or APP_BASE_URL.

RUN_ENGINE_LOOP=1
RUN_WORKER_LOOP=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
WORKER_OUTCOME_TRACKER_ENABLED=1
SHADOW_OUTCOME_TRACKER_ENABLED=1
ALLOW_ANALYTICS_IN_WORKER=1

# Single-primary PostgreSQL capacity for one Railway application replica.
# Diagnostics fail the launch gate if the database lacks headroom.
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_RAILWAY_ABSOLUTE_CAP=4
DB_MAX_OVERFLOW_RAILWAY_ABSOLUTE_CAP=2
DB_PRODUCTION_CONNECTION_RESERVE=5
DB_BACKGROUND_DROP_WHEN_BUSY=0
DB_NONCRITICAL_WRITE_DROP_ON_GATE_TIMEOUT=0

# Public multi-user delivery. Leave blank to use normal tier eligibility.
DELIVERY_AUDIENCE_ALLOWLIST=
RESEND_AUDIENCE_ALLOWLIST_ONLY=0
RESEND_MAX_USERS_PER_RUN=100
RESEND_INCLUDE_FREE=1
FREE_SIGNAL_DISTRIBUTION_ENABLED=1
# Never send random signals merely to create activity.
FREE_RANDOM_DISTRIBUTION_ENABLED=0

# Public tier enrollment and pricing. VIP_SEAT_LIMIT=0 means open enrollment.
PREMIUM_MONTHLY_PRICE_NGN=24000
PREMIUM_QUARTERLY_PRICE_NGN=56000
PREMIUM_YEARLY_PRICE_NGN=192000
VIP_MONTHLY_PRICE_NGN=40000
VIP_SEAT_LIMIT=0
# Optional recurring Paystack plan codes. Leave blank to use one-off checkout amounts.
PAYSTACK_PREMIUM_PLAN_CODE=
PAYSTACK_VIP_PLAN_CODE=

# Launch-grade paper trading: isolated virtual funds and confirmed deliveries only.
PAPER_TRADING_ENABLED=1
PAPER_AUTO_TRADE_DEFAULT_ENABLED=1
PAPER_TRADING_START_BALANCE_USD=10000
PAPER_DEFAULT_RISK_PCT=1
PAPER_DEFAULT_MAX_OPEN_POSITIONS=5
PAPER_DEFAULT_MIN_SIGNAL_SCORE=80
PAPER_DEFAULT_TARGET_MODE=TP1
PAPER_DEFAULT_SPREAD_BPS=2
PAPER_DEFAULT_SLIPPAGE_BPS=2
PAPER_DEFAULT_FEE_BPS=5
PAPER_AUTO_ENTRY_MAX_AGE_SECONDS=900
PAPER_TRADING_WORKER_INTERVAL_SECONDS=20
PAPER_TRADING_DELIVERY_BATCH_SIZE=200
PAPER_TRADING_MARK_BATCH_SIZE=100
PAPER_MAX_NOTIONAL_PCT=100
SIMULATION_MIN_CONFIRMED_OUTCOMES=10
SIMULATION_RUNS=2000

# Adaptive intelligence extends existing strategies; research cannot auto-promote.
ADAPTIVE_STRATEGY_ENGINE_ENABLED=1
ADAPTIVE_STRATEGY_GENERATION_ENABLED=1
ADAPTIVE_OPTIMISATION_ENABLED=1
ADAPTIVE_LEARNING_WORKER_ENABLED=1
ADAPTIVE_CANDLE_CAPTURE_ENABLED=1
ADAPTIVE_SHADOW_CANDIDATES_IN_SIGNAL_PIPELINE_ENABLED=0
ADAPTIVE_AUTO_PROMOTION_ENABLED=0
ADAPTIVE_REQUIRE_HUMAN_APPROVAL=1

# Canonical Telegram HTML cards. Every new signal is a fresh, audible Bot API
# message. Lifecycle updates reply to the card; they never edit/replace it.
DELIVERY_SIGNAL_UPDATE_ENABLED=0
LIFECYCLE_EVENT_NOTIFICATIONS_ENABLED=1
LIFECYCLE_TP_SL_NOTIFICATIONS_ENABLED=0
SEND_OUTCOME_NOTIFICATIONS_ENABLED=1
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_SEND_TIMEOUT_SECONDS=15
DELIVERY_PROOF_TIMEOUT_SECONDS=20
DELIVERY_USER_TIMEOUT_SECONDS=30
RESEND_UNSENT_INTERVAL_SECONDS=60
RESEND_UNSENT_STARTUP_DELAY_SECONDS=45
DELIVERY_TRACE_ENABLED=1
TELEGRAM_SEND_SUCCESS_LOG_ENABLED=1
TELEGRAM_RICH_MESSAGES_ENABLED=0
TELEGRAM_RICH_MESSAGES_CERTIFIED=0
TELEGRAM_RICH_MESSAGES_MODE=off
BOT_COMMAND_SCOPE_CONCURRENCY=4
BOT_COMMAND_SCOPE_BATCH_SIZE=25

# REST is authoritative until WebSocket circuits have a clean production soak.
WS_INGEST_ENABLED=0
WS_CRYPTO_ENABLED=0
TRADINGVIEW_ENABLED=0
TRADINGVIEW_MAX_RETRIES=1
TRADINGVIEW_CACHE_TTL_SECONDS=300
TRADINGVIEW_RATE_LIMIT_COOLDOWN_SECONDS=300

# Preserve evidence during DB pressure.
DECISION_LOG_RETRY_ENABLED=1
DECISION_LOG_RETRY_INTERVAL_SECONDS=30
DECISION_LOG_RETRY_BATCH_SIZE=100

# Live activation profile. Apply only after broker and Paystack transfer runtime proofs pass.
# Each user must still accept terms, opt in, link trade-only credentials, and pass every risk gate.
DEMO_EXECUTION_ENABLED=1
REAL_EXECUTION_ENABLED=1
AUTO_EXECUTION_ENABLED=1
AUTO_TRADE_ENABLED=1
COPY_TRADE_ENABLED=1
MT5_ALLOW_LIVE_ACCOUNTS=1
BYBIT_EXECUTION_ENABLED=1
BYBIT_TESTNET=0
BYBIT_REQUIRE_IP_BINDING=1
BYBIT_DEDICATED_ACCOUNT_ACK=I_CONFIRM_BYBIT_ACCOUNT_IS_DEDICATED_TO_SIGNALRANKAI
BYBIT_RECONCILIATION_ENABLED=1
BYBIT_RECONCILIATION_INTERVAL_SECONDS=30
BYBIT_RECONCILIATION_BATCH_SIZE=100
LIVE_FINANCIAL_FEATURES_ENABLED=1
LIVE_FINANCIAL_FEATURES_ACK=I_ACCEPT_REAL_MONEY_TRADING_AND_PAYOUT_RISK
GLOBAL_EXECUTION_KILL_SWITCH=0
LIVE_MAX_RISK_PER_TRADE_PCT=1
BYBIT_MAX_ENTRY_DEVIATION_PCT=1
BYBIT_MAX_NOTIONAL_MULTIPLIER=1

# Public subscriptions require valid live Paystack keys and a verified webhook.
PAYMENTS_ENABLED=1
PAYMENTS_PUBLIC_ENABLED=1
PAYMENTS_PUBLIC_TEST_MODE=0
REAL_PAYOUTS_ENABLED=1
AUTOMATIC_PAYOUTS_ENABLED=0
PAYOUT_MANUAL_APPROVAL_REQUIRED=1
PAYSTACK_TRANSFERS_ENABLED=1
PAYSTACK_TRANSFERS_APPROVED_ACK=I_CONFIRM_PAYSTACK_TRANSFERS_IS_ENABLED_FOR_THIS_BUSINESS
PAYSTACK_TRANSFER_OTP_FLOW_ENABLED=1
REAL_PAYOUTS_ACK=I_ACCEPT_MANUAL_APPROVAL_REAL_PAYOUT_RISK
PAYOUT_MINIMUM_NGN=1000
PAYOUT_MAXIMUM_NGN=1000000
# Replace these with a matching approved live Paystack key pair and webhook secret.
PAYSTACK_SECRET_KEY=<paystack-live-secret-key>
PAYSTACK_PUBLIC_KEY=<paystack-live-public-key>
PAYSTACK_WEBHOOK_SECRET=<paystack-webhook-secret>

PROXY_VALIDATION_ENABLED=0
ACTIVE_SIGNAL_KEYBOARD_REFRESH_ENABLED=0
ENGINE_PULSE_DISTRIBUTED_LOCK_ENABLED=1
ENGINE_PULSE_LOCK_TTL_SECONDS=3570

# Guarded staging flags must remain disabled in production.
PAYSTACK_LIVE_STAGING_ENABLED=0
PAYSTACK_LIVE_STAGING_ACK=
STAGING_DELIVERY_FRESHNESS_ADVISORY=0

# v1.3.1 outcome recovery, public cutover, live-financial fail-closed controls and durability
BOT_WEBHOOK_READY_MIN_HANDLERS=60
OUTCOME_TRACKER_DB_PRIORITY=critical
OUTCOME_DB_ADMISSION_TIMEOUT_SECONDS=12

OUTCOME_BACKFILL_SIGNAL_LIMIT=500
OUTCOME_BACKFILL_LOOKBACK_HOURS=168
CHECK_OUTCOME_RECONCILE_TIMEOUT_SECONDS=8
CHECK_OUTCOME_MAX_SNAPSHOT_AGE_SECONDS=30
MONITOR_RECONCILE_TIMEOUT_SECONDS=8
MONITOR_LIVE_PRICE_TIMEOUT_SECONDS=6
MONITOR_SNAPSHOT_MAX_AGE_SECONDS=30
TRADE_TRACKER_LATEST_TICK_MAX_AGE_SECONDS=15
ADAPTIVE_CANDLE_DB_PRIORITY=background
ADAPTIVE_CANDLE_DB_TIMEOUT_SECONDS=12
ADAPTIVE_CANDLE_CAPTURE_MAX_PER_TIMEFRAME=200
ADAPTIVE_CANDLE_OPEN_UPDATE_INTERVAL_SECONDS=30
ADAPTIVE_CANDLE_UPSERT_CHUNK_SIZE=200

# Foreground command resilience
DB_INTERACTIVE_SESSION_GATE_TIMEOUT_SECONDS=3

# Suppress duplicate ready messages during Railway rolling deploy overlap
BOT_READY_NOTIFICATION_DEDUPE_SECONDS=180

# Production cutover gates. The /readyz route returns 503 if the actual Railway
# environment is not production, a delivery allowlist is present, or either
# engine/worker loop is disabled.
PORTFOLIO_EXPOSURE_REQUIRE_DELIVERED=1
PORTFOLIO_EXPOSURE_FAIL_OPEN=0
PORTFOLIO_MAX_GLOBAL_TRADES=5
PORTFOLIO_MAX_SECTOR_DIRECTION=2
