* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Deployment entrypoints must retain Unix line endings on Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Retained verification receipts/logs are hash-bound to their original bytes.
docs/release/evidence/local-20261016/** -text whitespace=cr-at-eol
docs/release/evidence/continuation-20261016/** -text whitespace=cr-at-eol
docs/release/evidence/continuation-20261017/** -text whitespace=cr-at-eol
# Original diagnostic tracebacks contain significant whitespace; retain bytes.
docs/release/evidence/continuation-20261016/*.log -whitespace
docs/release/evidence/continuation-20261017/*.log -whitespace
