# Optional delivery-reconciliation worker. The engine still creates the
# canonical candidate and delivery outbox; this role reconciles durable receipts.
RUN_MODE=delivery
HONOR_RUN_MODE_ON_RAILWAY=true
WORKER_OUTCOME_TRACKER_ENABLED=0
REALTIME_OUTCOME_TRACKER_ENABLED=0
SHADOW_OUTCOME_TRACKER_ENABLED=0
ASSET_LEARNING_ENABLED=0
ANALYTICS_ML_TRAIN_ENABLED=0
