APP_VERSION=1.3.5
SIGNALRANK_ENV_PROFILE=staging
# SignalRankAI v1.3.5 — ML learning/runtime reliability
# Apply in Railway staging first. Keep one application replica while the
# monolith owns singleton engine/scheduler/resend jobs.

# ── Reviewed monolith Postgres pool ────────────────────────────────────────
DB_ALLOW_REVIEWED_MONOLITH_POOL=1
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=4
DB_POOL_RAILWAY_ABSOLUTE_CAP=12
DB_MAX_OVERFLOW_RAILWAY_ABSOLUTE_CAP=4
DB_REVIEWED_MONOLITH_POOL_MAX=12
DB_REVIEWED_MONOLITH_OVERFLOW_MAX=4
DB_MAX_CONCURRENT_SESSIONS=16

# Reserve capacity for Telegram commands, signal persistence, delivery proofs,
# and outcome state transitions while allowing durable maintenance work to run.
DB_FOREGROUND_RESERVED_SESSIONS=4
DB_INTERACTIVE_MAX_CONCURRENT_SESSIONS=2
DB_CRITICAL_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=4
DB_INTERACTIVE_SESSION_GATE_TIMEOUT_SECONDS=2
DB_CRITICAL_SESSION_GATE_TIMEOUT_SECONDS=12
DB_BACKGROUND_SESSION_GATE_TIMEOUT_SECONDS=30
DB_AUX_LOOPS_USE_NULLPOOL=1
DB_AUXILIARY_NULLPOOL=1
DB_NONCRITICAL_DROP_WHEN_CRITICAL_ACTIVE=0

# ── Supervised and shadow ML learning ─────────────────────────────────────
ML_TRAINING_DB_PRIORITY=background
ML_TRAINING_DB_TIMEOUT_SECONDS=30
ML_TRAIN_LOOKBACK_DAYS=180
ML_MIN_TRAIN_ROWS=100
ML_MIN_LIVE_PROOF_ROWS=10
ML_MIN_EFFECTIVE_ROWS=50
ML_MIN_PROMOTION_AUC=0.52
ML_MIN_PROMOTION_ACCURACY=0.50
ML_CANDLE_CACHE_MAX_ROWS_PER_SERIES=40000
ML_REQUIRE_DURABLE_MODEL_ARTIFACT=1
ML_REQUIRE_DURABLE_CANDIDATE_ARTIFACT=1
ML_RESTORE_ACTIVE_ARTIFACT_ON_STARTUP=1
ML_RESTORE_CANDIDATE_ARTIFACT_ON_STARTUP=1
OUTCOME_TRACKER_ML_RETRAIN_INTERVAL_SECONDS=21600

# Match this to Railway CPU allocation: 1 on a 1-vCPU service, 2 on 2+ vCPU.
XGB_NTHREAD=2

# ── Full-candle and rejected-signal learning ──────────────────────────────
ADAPTIVE_CANDLE_CAPTURE_ENABLED=1
ADAPTIVE_CANDLE_DB_PRIORITY=background
ADAPTIVE_CANDLE_DB_TIMEOUT_SECONDS=20
ADAPTIVE_CANDLE_CAPTURE_INTERVAL_SECONDS=10
ADAPTIVE_CANDLE_CAPTURE_BATCH_SIZE=24
ADAPTIVE_CANDLE_UPSERT_CHUNK_SIZE=250
SHADOW_OUTCOME_DB_TIMEOUT_SECONDS=20

# ── Response-latency controls ─────────────────────────────────────────────
BOT_COMMAND_SCOPE_BULK_REFRESH_ENABLED=0
ACTIVE_SIGNAL_KEYBOARD_REFRESH_ENABLED=0
BOT_MINIMAL_SCHEDULER_MODE=1
WEBHOOK_UPDATE_WORKERS=4
WEBHOOK_UPDATE_QUEUE_SIZE=1000
OUTCOME_NOTIFICATION_INTERVAL_SECONDS=60
MONITOR_REFRESH_INTERVAL_SECONDS=120

# Disable the expensive post-start diagnostics subprocess after one successful
# certification run. Re-enable it only for deliberate release certification.
DEPLOYMENT_DIAGNOSTICS_ENABLED=0
