# SignalRankAI v1.2.3 full-system Railway staging test profile
# Enables every major workflow while forcing external integrations to sandbox/demo boundaries.
APP_VERSION=1.2.3
APP_ENV=staging
PUBLIC_TESTING_MODE=1
FULL_SYSTEM_STAGING_TEST_MODE=1
FULL_SYSTEM_STAGING_TEST_ACK=I_UNDERSTAND_STAGING_TESTS_CAN_TRIGGER_EXTERNAL_ACTIONS

# Comma-separated Telegram IDs permitted to receive test traffic. Add selected testers only.
FULL_SYSTEM_TEST_USER_IDS=1409578077
DELIVERY_AUDIENCE_ALLOWLIST=1409578077
RESEND_AUDIENCE_ALLOWLIST_ONLY=1

RUN_ENGINE_LOOP=1
RUN_WORKER_LOOP=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
WORKER_OUTCOME_TRACKER_ENABLED=1
SHADOW_OUTCOME_TRACKER_ENABLED=1
ALLOW_ANALYTICS_IN_WORKER=1

# Exercise free, paid, random, resend and tier-routing paths against the allowlisted testers.
FREE_SIGNAL_DISTRIBUTION_ENABLED=1
FREE_RANDOM_DISTRIBUTION_ENABLED=1

# Persistent automatic paper trading.
PAPER_TRADING_ENABLED=1
PAPER_AUTO_TRADE_DEFAULT_ENABLED=1
PAPER_AUTO_EXECUTION_ENABLED=1
PAPER_TRADING_START_BALANCE_USD=10000
PAPER_DEFAULT_RISK_PCT=0.25
PAPER_DEFAULT_MAX_OPEN_POSITIONS=3
PAPER_DEFAULT_MIN_SIGNAL_SCORE=80
PAPER_DEFAULT_TARGET_MODE=TP1
PAPER_DEFAULT_SPREAD_BPS=2
PAPER_DEFAULT_SLIPPAGE_BPS=2
PAPER_DEFAULT_FEE_BPS=5
PAPER_AUTO_ENTRY_MAX_AGE_SECONDS=900
PAPER_TRADING_WORKER_INTERVAL_SECONDS=20
PAPER_WORKER_DB_PRIORITY=interactive
PAPER_DB_TIMEOUT_SECONDS=12
DB_BACKGROUND_DROP_WHEN_BUSY=0
DB_NONCRITICAL_WRITE_DROP_ON_GATE_TIMEOUT=0

# Adaptive/ML paths. Keep human approval for strategy promotion while testing.
ADAPTIVE_STRATEGY_ENGINE_ENABLED=1
ADAPTIVE_STRATEGY_GENERATION_ENABLED=1
ADAPTIVE_OPTIMISATION_ENABLED=1
ADAPTIVE_LEARNING_WORKER_ENABLED=1
ADAPTIVE_CANDLE_CAPTURE_ENABLED=1
ADAPTIVE_SHADOW_CANDIDATES_IN_SIGNAL_PIPELINE_ENABLED=1
ADAPTIVE_AUTO_PROMOTION_ENABLED=0
ADAPTIVE_REQUIRE_HUMAN_APPROVAL=1

# Exercise both legacy HTML and structural Telegram card paths.
TELEGRAM_RICH_MESSAGES_ENABLED=1
TELEGRAM_RICH_MESSAGES_CERTIFIED=0
TELEGRAM_RICH_MESSAGES_MODE=canary
ACTIVE_SIGNAL_KEYBOARD_REFRESH_ENABLED=1

# Exercise REST plus WebSocket ingestion. REST remains fallback/authority.
WS_INGEST_ENABLED=1
WS_CRYPTO_ENABLED=1
CRYPTO_WS_ENABLED=1

# Configure WEBSHARE_PROXY_URL or PROXY_PROVIDER_URL before turning this on.
WEBSHARE_PROXY_URL=
PROXY_VALIDATION_ENABLED=0

# Enable execution workflows. Use only MetaApi demo accounts.
DEMO_EXECUTION_ENABLED=1
REAL_EXECUTION_ENABLED=1
AUTO_EXECUTION_ENABLED=1
AUTO_TRADE_ENABLED=1
COPY_TRADE_ENABLED=1
MT5_ALLOW_LIVE_ACCOUNTS=0
MAX_ACTIVE_TRADES=2
RISK_PER_TRADE_PCT=0.10

# Enable Bybit workflow against testnet credentials only.
BYBIT_EXECUTION_ENABLED=1
BYBIT_TESTNET=1
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Enable payment and payout workflows with Paystack TEST keys only.
PAYMENTS_ENABLED=1
PAYMENTS_PUBLIC_ENABLED=1
PAYMENTS_PUBLIC_TEST_MODE=1
REAL_PAYOUTS_ENABLED=1
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

TV_WEBHOOK_SECRET=

ENGINE_PULSE_DISTRIBUTED_LOCK_ENABLED=1
ENGINE_PULSE_LOCK_TTL_SECONDS=3570
