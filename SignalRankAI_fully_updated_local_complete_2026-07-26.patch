+        execution_mode="manual_confirmed",
+        execution_authorized=True,
+        idempotency_key="idem",
+    )
+
+    assert result.success is True
+    assert result.order_id == "broker-order"
+    ledger.assert_awaited_once()
+    paper.assert_awaited_once()
