+    IMPLEMENTED_AND_SANDBOX_VERIFIED = "IMPLEMENTED_AND_SANDBOX_VERIFIED"
+    IMPLEMENTED_AND_LIVE_VERIFIED = "IMPLEMENTED_AND_LIVE_VERIFIED"
+    IMPLEMENTED_AND_MOCK_VERIFIED = "IMPLEMENTED_AND_MOCK_VERIFIED"
