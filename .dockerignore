# .dockerignore
.git/
.agents/
.codex/
.aws/
.railway/
.venv/
venv/
.audit-venv/
.audit-tools-venv/
.pytest-tmp/
.pytest_cache/
.mypy_cache/
.ruff_cache/
artifacts/
evidence/
logs/
.diagnostics/
**/node_modules/
frontend/.next/
mobile/dist-android/
mobile/dist-ios/
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.env.*
*.sqlite3
*.db
*.log
alembic/versions/

# Ignore test and dev artifacts
tests/
docs/
admin/
*.md
deploy*.txt
deploy*.md
IMPLEMENTATION_*.md
AUDIT_*.md
CHANGELOG_*.md
manual_migration_*.sql
APPLY_ML_COLUMN_IMMEDIATELY.sql
fix_*.py
test_*.py
tmp_test_*.py
*.ipynb
*.bak
*.swp
*.tmp
*.old
*.orig
*.egg-info/

# Ignore OS files
.DS_Store
Thumbs.db

# Runtime deployment diagnostics require these proof inputs.  Re-include them
# after the broad development-artifact exclusions above.
!.env.example
!CURRENT_RELEASE.md
!docs/
!docs/**
# Release-critical pytest gate runs inside the Railway image build.
!tests/
!tests/**
