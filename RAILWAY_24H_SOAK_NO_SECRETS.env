# SignalRankAI 24-hour owner soak — NON-SECRET configuration only
# Keep existing DATABASE_URL, Redis URLs, Telegram token, owner IDs and API keys
# in Railway Variables. This file intentionally contains none of them.

APP_ENV=staging
PUBLIC_TESTING_MODE=1
ALL_ASSET_TESTING_MODE=1
ALL_ASSET_MODE=1
ASSET_CLASSES_ENABLED=crypto,fx,index,commodity,stock
DEFAULT_TRADING_STYLE=day

# Hard safety gates — do not enable for an observation soak
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
REAL_PAYOUTS_ENABLED=0
PAYMENTS_PUBLIC_ENABLED=0
PAYMENTS_ENABLED=0
PAYMENTS_PUBLIC_TEST_MODE=1
AUTOMATON_MODE=SIMULATION
CODEXOPS_MODE=READ_ONLY_AUDIT
CHAT_MT5_CREDENTIALS_ENABLED=0
TELEGRAM_ALLOW_PAID_BROADCAST=0

# Database / PgBouncer
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_SIZE_RAILWAY=2
DB_MAX_OVERFLOW_RAILWAY=0
DB_MAX_CONCURRENT_SESSIONS=2
DB_BACKGROUND_MAX_CONCURRENT_SESSIONS=1
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=1
DB_AUXILIARY_NULLPOOL=1
DB_POOL_DISABLE_RAILWAY_CAP=0
DB_POOL_ALLOW_UNCAPPED_RAILWAY=0

# Market data and provider coordination
USE_MULTI_PROVIDER_DATA=true
MARKET_FETCH_ASSET_CONCURRENCY=2
MARKET_CACHE_FETCH_CONCURRENCY=2
OHLC_PROVIDER_REQUEST_TIMEOUT_SECONDS=7
MARKET_PROVIDER_TIMEOUT_SECONDS=7
OHLC_REQUIRED_ASSET_TIMEOUT_SECONDS=20
OHLC_OPTIONAL_ASSET_TIMEOUT_SECONDS=12
OHLC_ENGINE_BATCH_TIMEOUT_SECONDS=50
OHLC_MAX_PROVIDER_ATTEMPTS_PER_TIMEFRAME=2
OHLC_ORPHAN_TASK_GUARD_ENABLED=1
OHLC_PROVIDER_QUEUE_TIMEOUT_SECONDS=10
OHLC_INFLIGHT_WAIT_TIMEOUT_SECONDS=25
OHLC_DEFAULT_PROVIDER_MAX_CONCURRENCY=1
COINBASE_OHLC_MAX_CONCURRENCY=2
OKX_OHLC_MAX_CONCURRENCY=2
BYBIT_OHLC_MAX_CONCURRENCY=1
KRAKEN_OHLC_MAX_CONCURRENCY=1
KUCOIN_OHLC_MAX_CONCURRENCY=1
YFINANCE_OHLC_MAX_CONCURRENCY=1
TWELVEDATA_OHLC_MAX_CONCURRENCY=1
POLYGON_OHLC_MAX_CONCURRENCY=1
FMP_OHLC_MAX_CONCURRENCY=1
OANDA_OHLC_MAX_CONCURRENCY=1
TIINGO_OHLC_MAX_CONCURRENCY=1
ALPHAVANTAGE_OHLC_MAX_CONCURRENCY=1
CRYPTO_MARKET_DATA_PROVIDERS=coinbase,okx,bybit,kraken,cryptocompare,kucoin
CRYPTO_PREFERRED_PROVIDER=coinbase
BINANCE_MARKET_DATA_ENABLED=0
YFINANCE_CRYPTO_PRIMARY_ENABLED=0
ECB_FX_DAILY_ENABLED=1

# Engine
ENGINE_CYCLE_SLEEP_SECONDS=30
ENGINE_UNIVERSE_CAP=30
CYCLE_BATCH_SIZE=6
SEGMENT_QUARANTINE_ENABLED=1
SEGMENT_QUARANTINE_TIMEOUT_SECONDS=4
SEGMENT_QUARANTINE_FAIL_CLOSED=0
LEGACY_TRADE_TRACKER_ENABLED=0

# Freshness and delivery — fail closed but allow bounded fanout time
STALE_PRICE_THRESHOLD_PCT=1.5
USE_DYNAMIC_DRIFT=1
GHOST_PRICE_CHECK=1
DELIVERY_SIGNAL_UPDATE_ENABLED=0
DELIVERY_REQUIRE_LIVE_PRICE=1
FINAL_SEND_LIVE_PRICE_CHECK_ENABLED=1
FINAL_SEND_FORCE_FRESH_PRICE=1
FINAL_SEND_LIVE_PRICE_TIMEOUT_SECONDS=4
DELIVERY_FRESHNESS_TIMEOUT_SECONDS=7
DELIVERY_FRESHNESS_TIMEOUT_FAIL_OPEN=0
DELIVERY_FRESHNESS_ERROR_FAIL_OPEN=0
DELIVERY_MISSING_PRICE_FAIL_OPEN=0
DELIVERY_QUEUE_MAX_AGE_CRYPTO_SECONDS=300
DELIVERY_QUEUE_MAX_AGE_FOREX_SECONDS=300
DELIVERY_QUEUE_MAX_AGE_STOCK_SECONDS=300
DELIVERY_QUEUE_MAX_AGE_INDEX_SECONDS=300
DELIVERY_QUEUE_MAX_AGE_COMMODITY_SECONDS=180
DELIVERY_QUEUE_MAX_AGE_GOLD_SECONDS=120
ENGINE_DELIVERY_ASYNC_FANOUT=1
ENGINE_DELIVERY_FANOUT_LOCK_SECONDS=600
DELIVERY_TRACE_ENABLED=1
TELEGRAM_SEND_SUCCESS_LOG_ENABLED=1
TELEGRAM_SEND_MAX_ATTEMPTS=3
TELEGRAM_RETRY_AFTER_MAX_SECONDS=60
TELEGRAM_BROADCAST_RPS=20
BROADCASTER_MAX_PARALLEL=20
BROADCASTER_MAX_RETRIES=3

# Learning from rejected/stale signals and all asset classes
REJECTION_LOG_WRITE_ENABLED=1
SHADOW_TRACKING_ENABLED=1
SHADOW_OUTCOME_TRACKER_ENABLED=1
WORKER_SHADOW_TRACKER_ENABLED=0
SHADOW_TRACKER_INTERVAL_SECONDS=60
SHADOW_TRACKER_BATCH_SIZE=50
SHADOW_PRICE_CONCURRENCY=3
REJECT_OUTCOME_MIN_TRACK_AGE_MINUTES=5
ASSET_LEARNING_ENABLED=1
ASSET_LEARNING_INTERVAL_SECONDS=900
ASSET_LEARNING_ASSETS_PER_CYCLE=12
ASSET_LEARNING_CONCURRENCY=2
ASSET_LEARNING_TIMEFRAMES=1h,4h,1d
ASSET_LEARNING_CRYPTO_LIMIT=40
ASSET_LEARNING_STOCK_LIMIT=40
ANALYTICS_ML_TRAIN_ENABLED=1
ANALYTICS_ML_TRAIN_STARTUP_DELAY_SECONDS=900
ML_TRAIN_INTERVAL_SECONDS=86400
OUTCOME_TRACK_DELIVERED_ONLY=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
WORKER_OUTCOME_TRACKER_ENABLED=1
REALTIME_OUTCOME_TRACKER_ENABLED=1
SEND_OUTCOME_NOTIFICATIONS_ENABLED=1

# AI/news degradation controls
ENABLE_NEWS=1
ENABLE_ML=1
GEMINI_SIGNAL_REVIEW_CIRCUIT_BREAKER_ENABLED=1
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=1800
GEMINI_SIGNAL_REVIEW_MAX_CALLS_PER_WINDOW=2
GEMINI_SIGNAL_REVIEW_TIMEOUT_SEC=4

# Queue, webhook, observability
WEBHOOK_REDIS_QUEUE_ENABLED=1
WEBHOOK_UPDATE_WORKERS=4
WEBHOOK_UPDATE_QUEUE_SIZE=1000
REDIS_WEBHOOK_QUEUE_MAX_DEPTH=5000
CALLBACK_FAST_ACK_ENABLED=1
DELIVERY_RECONCILE_BATCH_SIZE=100
DELIVERY_RECONCILE_INTERVAL_SECONDS=30
OBSERVABILITY_METRICS_ENABLED=1
LOG_JSON=1
RUN_DB_MIGRATIONS_AT_BOOT=false
INSTALL_AT_BOOT=false
ALLOW_DOTENV=false

# Non-crypto provider policy (keys remain in existing Railway secret variables)
STOCK_MARKET_DATA_PROVIDERS=twelvedata,fmp,tiingo,polygon,alphavantage,yfinance
FX_MARKET_DATA_PROVIDERS=twelvedata,oanda,fmp,alphavantage,tiingo,polygon,yfinance,ecb
INDEX_MARKET_DATA_PROVIDERS=fmp,twelvedata,polygon,alphavantage,yfinance
COMMODITY_MARKET_DATA_PROVIDERS=fmp,twelvedata,alphavantage,oanda,yfinance
