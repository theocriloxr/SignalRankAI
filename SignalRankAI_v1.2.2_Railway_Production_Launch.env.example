# SignalRankAI v1.2.2 production launch profile — secrets are supplied in Railway
APP_VERSION=1.2.2
APP_ENV=production
PUBLIC_TESTING_MODE=0
DRY_RUN=0

RUN_ENGINE_LOOP=1
RUN_WORKER_LOOP=1
ENGINE_OUTCOME_TRACKER_ENABLED=0
WORKER_OUTCOME_TRACKER_ENABLED=1
SHADOW_OUTCOME_TRACKER_ENABLED=1
ALLOW_ANALYTICS_IN_WORKER=1

# Public multi-user delivery. Leave blank to use normal tier eligibility.
DELIVERY_AUDIENCE_ALLOWLIST=
RESEND_AUDIENCE_ALLOWLIST_ONLY=0
RESEND_MAX_USERS_PER_RUN=100
RESEND_INCLUDE_FREE=1
FREE_SIGNAL_DISTRIBUTION_ENABLED=1
# Never send random signals merely to create activity.
FREE_RANDOM_DISTRIBUTION_ENABLED=0

# Launch-grade paper trading: isolated virtual funds and confirmed deliveries only.
PAPER_TRADING_ENABLED=1
PAPER_AUTO_TRADE_DEFAULT_ENABLED=1
PAPER_TRADING_START_BALANCE_USD=10000
PAPER_DEFAULT_RISK_PCT=1
PAPER_DEFAULT_MAX_OPEN_POSITIONS=5
PAPER_DEFAULT_MIN_SIGNAL_SCORE=80
PAPER_DEFAULT_TARGET_MODE=TP1
PAPER_DEFAULT_SPREAD_BPS=2
PAPER_DEFAULT_SLIPPAGE_BPS=2
PAPER_DEFAULT_FEE_BPS=5
PAPER_AUTO_ENTRY_MAX_AGE_SECONDS=900
PAPER_TRADING_WORKER_INTERVAL_SECONDS=20
PAPER_TRADING_DELIVERY_BATCH_SIZE=200
PAPER_TRADING_MARK_BATCH_SIZE=100
PAPER_MAX_NOTIONAL_PCT=100
SIMULATION_MIN_CONFIRMED_OUTCOMES=10
SIMULATION_RUNS=2000

# Adaptive intelligence extends existing strategies; research cannot auto-promote.
ADAPTIVE_STRATEGY_ENGINE_ENABLED=1
ADAPTIVE_STRATEGY_GENERATION_ENABLED=1
ADAPTIVE_OPTIMISATION_ENABLED=1
ADAPTIVE_LEARNING_WORKER_ENABLED=1
ADAPTIVE_CANDLE_CAPTURE_ENABLED=1
ADAPTIVE_SHADOW_CANDIDATES_IN_SIGNAL_PIPELINE_ENABLED=0
ADAPTIVE_AUTO_PROMOTION_ENABLED=0
ADAPTIVE_REQUIRE_HUMAN_APPROVAL=1

# Canonical Telegram HTML cards. Structural rich cards remain canary-only.
TELEGRAM_RICH_MESSAGES_ENABLED=0
TELEGRAM_RICH_MESSAGES_CERTIFIED=0
TELEGRAM_RICH_MESSAGES_MODE=off
BOT_COMMAND_SCOPE_CONCURRENCY=4
BOT_COMMAND_SCOPE_BATCH_SIZE=25

# REST is authoritative until WebSocket circuits have a clean production soak.
WS_INGEST_ENABLED=0
WS_CRYPTO_ENABLED=0
TRADINGVIEW_ENABLED=1
TRADINGVIEW_MAX_RETRIES=1
TRADINGVIEW_CACHE_TTL_SECONDS=300
TRADINGVIEW_RATE_LIMIT_COOLDOWN_SECONDS=300

# Preserve evidence during DB pressure.
DECISION_LOG_RETRY_ENABLED=1
DECISION_LOG_RETRY_INTERVAL_SECONDS=30
DECISION_LOG_RETRY_BATCH_SIZE=100
OUTCOME_DB_ADMISSION_TIMEOUT_SECONDS=1

# Optional demo execution is allowed only after each user links and verifies a demo account.
DEMO_EXECUTION_ENABLED=1
REAL_EXECUTION_ENABLED=0
AUTO_EXECUTION_ENABLED=0
AUTO_TRADE_ENABLED=0
COPY_TRADE_ENABLED=0
MT5_ALLOW_LIVE_ACCOUNTS=0
BYBIT_EXECUTION_ENABLED=0

# Public subscriptions require valid live Paystack keys and a verified webhook.
PAYMENTS_ENABLED=1
PAYMENTS_PUBLIC_ENABLED=1
REAL_PAYOUTS_ENABLED=0
# Required Railway secrets (do not commit values):
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_WEBHOOK_SECRET=...

PROXY_VALIDATION_ENABLED=0
ACTIVE_SIGNAL_KEYBOARD_REFRESH_ENABLED=0
ENGINE_PULSE_DISTRIBUTED_LOCK_ENABLED=1
ENGINE_PULSE_LOCK_TTL_SECONDS=3570
